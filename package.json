{
  "name": "meridian-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Meridian Design System — token source of truth and doc site build scripts.",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs",
    "check:tokens": "node scripts/build-tokens.mjs --check",
    "build:semantic-meta": "node scripts/build-semantic-meta.mjs",
    "check:semantic-meta": "node scripts/build-semantic-meta.mjs --check",
    "build:icon-meta": "node scripts/build-icon-meta.mjs",
    "check:icon-meta": "node scripts/build-icon-meta.mjs --check",
    "build:a11y-meta": "node scripts/build-accessibility-meta.mjs",
    "check:a11y-meta": "node scripts/build-accessibility-meta.mjs --check",
    "build:content-meta": "node scripts/build-content-meta.mjs",
    "check:content-meta": "node scripts/build-content-meta.mjs --check",
    "build:component-meta": "node scripts/build-component-meta.mjs",
    "check:component-meta": "node scripts/build-component-meta.mjs --check",
    "check:implementation-ready": "node scripts/check-implementation-readiness.mjs",
    "build:harness": "node scripts/build-component-harness.mjs",
    "check:harness": "node scripts/build-component-harness.mjs --check",
    "sync:component-registry": "node scripts/sync-component-registry.mjs",
    "sync:component-tokens": "node scripts/sync-component-token-usage.mjs",
    "design:build": "node scripts/build-design-md.mjs",
    "design:check": "node scripts/build-design-md.mjs --check",
    "design:lint": "node scripts/design-lint.mjs",
    "check:js": "node scripts/check-js.mjs",
    "inspect:project": "node scripts/inspect-project.mjs",
    "check:project": "node scripts/inspect-project.mjs --check",
    "generate:adapter-resolution": "node scripts/generate-adapter-resolution.mjs",
    "check:adapter-resolution": "node scripts/generate-adapter-resolution.mjs --check",
    "generate:adapter-token-mapping": "node scripts/generate-adapter-token-mapping.mjs",
    "check:adapter-token-mapping": "node scripts/generate-adapter-token-mapping.mjs --check",
    "generate:generic-review": "node scripts/generate-generic-review.mjs test/fixtures/ui-generation/issue-triage.generation-manifest.json",
    "check:generic-review": "node scripts/generate-generic-review.mjs test/fixtures/ui-generation/issue-triage.generation-manifest.json --check",
    "generate:team-fixture": "node scripts/generate-team-invitation-fixture.mjs && node scripts/generate-generic-review.mjs test/fixtures/ui-generation/team-invitation.generation-manifest.json",
    "check:team-fixture": "node scripts/generate-team-invitation-fixture.mjs --check && node scripts/generate-generic-review.mjs test/fixtures/ui-generation/team-invitation.generation-manifest.json --check",
    "capture:generic-browser-qa": "node scripts/capture-generic-browser-qa.mjs",
    "check:generic-browser-qa": "node scripts/capture-generic-browser-qa.mjs --check",
    "generate:generation-report": "node scripts/generate-generation-report.mjs",
    "check:generation-report": "node scripts/generate-generation-report.mjs --check",
    "validate:system": "node scripts/validate-system.mjs",
    "generate:phase2": "node scripts/generate-phase-2.mjs",
    "check:phase2": "node scripts/generate-phase-2.mjs --check",
    "capture:visual": "node scripts/capture-visual-candidates.mjs",
    "build:adapter-spike": "npm run build --prefix spikes/external-adapters",
    "evaluate:adapter-spike": "npm run evaluate --prefix spikes/external-adapters",
    "check:adapter-spike": "npm run check --prefix spikes/external-adapters",
    "refine:status": "node scripts/refinement-status.mjs",
    "refine:start": "node scripts/start-refinement.mjs",
    "refine:complete-impacts": "node scripts/complete-impact-followups.mjs",
    "test": "node --test test/*.test.js",
    "check:system": "npm run validate:system && npm run check:project && npm run check:adapter-token-mapping && npm run check:adapter-resolution && npm run check:generic-review && npm run check:team-fixture && npm run check:generation-report && npm run check:implementation-ready && npm run check:tokens && npm run check:semantic-meta && npm run check:icon-meta && npm run check:a11y-meta && npm run check:content-meta && npm run check:component-meta && npm run check:harness && npm run design:check && npm run check:phase2 && npm run check:js && npm test"
  },
  "license": "UNLICENSED"
}
