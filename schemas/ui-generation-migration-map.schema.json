{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.local/schemas/ui-generation-migration-map.schema.json",
  "title": "Meridian UI Generation Legacy Artifact Migration Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "sourceArtifacts", "mappings", "targetCoverage", "placement", "blockers"],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "sourceArtifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceArtifact" } },
    "mappings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mapping" } },
    "targetCoverage": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/coverage" } },
    "placement": { "$ref": "#/$defs/placement" },
    "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "stringList": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "digest": { "type": "string", "pattern": "^sha256-[a-f0-9]{64}$" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "id", "title", "status", "createdAt"],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "kind": { "const": "ui-generation-migration-map" },
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["draft", "validated", "superseded"] },
        "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "legacyKind", "path", "schemaVersion", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "legacyKind": { "enum": ["phase-1-package", "screen-spec", "flow-spec", "phase-2-concept", "component-composition", "component-usage", "review-ui", "visual-review"] },
        "path": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$" },
        "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceArtifactRefs", "targetArtifactTypes", "strategy", "status", "preservedContent", "notes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sourceArtifactRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "targetArtifactTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "strategy": { "enum": ["direct", "extract", "combine", "derive", "evidence-only"] },
        "status": { "enum": ["ready", "requires-transformation", "blocked"] },
        "preservedContent": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
        "notes": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetArtifactType", "status", "mappingRefs", "gap"],
      "properties": {
        "targetArtifactType": { "$ref": "#/$defs/id" },
        "status": { "enum": ["ready", "partial", "missing", "not-applicable"] },
        "mappingRefs": { "$ref": "#/$defs/stringList" },
        "gap": { "type": ["string", "null"] }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendedState", "canEnter", "nextState", "blockingTargetTypes", "reason"],
      "properties": {
        "recommendedState": { "$ref": "#/$defs/id" },
        "canEnter": { "type": "boolean" },
        "nextState": { "type": ["string", "null"] },
        "blockingTargetTypes": { "$ref": "#/$defs/stringList" },
        "reason": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "targetArtifactTypes", "message", "resolution"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "targetArtifactTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "message": { "$ref": "#/$defs/nonEmpty" },
        "resolution": { "$ref": "#/$defs/nonEmpty" }
      }
    }
  }
}
