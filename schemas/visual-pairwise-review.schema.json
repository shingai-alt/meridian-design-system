{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.local/schemas/visual-pairwise-review.schema.json",
  "title": "Meridian Human Visual Pairwise Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "conceptId", "rubricId", "captureManifestRef", "createdAt", "reviewer", "status", "requiredComparisonIds", "standings", "result", "comparisons", "tieBreakComparisons"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "kind": { "const": "visual-pairwise-review" },
    "conceptId": { "type": "string" },
    "rubricId": { "type": "string" },
    "captureManifestRef": { "type": "string" },
    "createdAt": { "type": "string" },
    "reviewer": { "type": "string", "minLength": 1 },
    "status": { "enum": ["in-progress", "complete"] },
    "requiredComparisonIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "standings": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateId", "wins"],
        "properties": { "candidateId": { "type": "string" }, "wins": { "type": "integer", "minimum": 0 } }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "winner"],
      "properties": {
        "state": { "enum": ["incomplete", "decision-ready", "additional-comparison-required"] },
        "winner": { "type": ["string", "null"] }
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["comparisonId", "left", "right", "winner", "reason", "reviewer", "scenarioId", "viewport", "evidenceRefs", "recordedAt"],
        "properties": {
          "comparisonId": { "type": "string" },
          "left": { "type": "string" },
          "right": { "type": "string" },
          "winner": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 },
          "reviewer": { "type": "string", "minLength": 1 },
          "scenarioId": { "type": "string" },
          "viewport": { "enum": ["desktop", "mobile"] },
          "evidenceRefs": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } },
          "recordedAt": { "type": "string" }
        }
      }
    },
    "tieBreakComparisons": {
      "type": "array",
      "items": { "$ref": "#/properties/comparisons/items" }
    }
  }
}
