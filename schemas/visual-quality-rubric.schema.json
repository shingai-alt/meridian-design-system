{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.local/schemas/visual-quality-rubric.schema.json",
  "title": "Meridian Visual Quality Rubric",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "scale", "criteria", "decisionPolicy"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "id": { "type": "string" },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "const": 1 },
        "maximum": { "const": 5 }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "weight", "question", "anchors"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string", "minLength": 1 },
          "weight": { "type": "integer", "minimum": 1 },
          "question": { "type": "string", "minLength": 1 },
          "anchors": {
            "type": "object",
            "additionalProperties": false,
            "required": ["1", "3", "5"],
            "properties": {
              "1": { "type": "string", "minLength": 1 },
              "3": { "type": "string", "minLength": 1 },
              "5": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "decisionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumWeightedScore", "maximumMajorFindings", "humanComparisonRequired"],
      "properties": {
        "minimumWeightedScore": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maximumMajorFindings": { "type": "integer", "minimum": 0 },
        "humanComparisonRequired": { "const": true }
      }
    }
  }
}
