{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.local/schemas/iconography.schema.json",
  "title": "Meridian Iconography Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "implementation", "coordinateSystem", "sizes", "accessibility", "icons"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "implementation": { "type": "string", "minLength": 1 },
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewBox", "strokeWidth", "smallStrokeWidth", "lineCap", "lineJoin", "color"],
      "properties": {
        "viewBox": { "const": "0 0 24 24" },
        "strokeWidth": { "type": "number", "minimum": 1, "maximum": 3 },
        "smallStrokeWidth": { "type": "number", "minimum": 1, "maximum": 3 },
        "lineCap": { "enum": ["round", "butt", "square"] },
        "lineJoin": { "enum": ["round", "bevel", "miter"] },
        "color": { "const": "currentColor" }
      }
    },
    "sizes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value", "usage"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "value": { "type": "integer", "minimum": 8, "maximum": 64 },
          "usage": { "type": "string", "minLength": 1 }
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["svgDefaults", "iconOnlyControl", "informative", "decorative", "contrast"],
      "properties": {
        "svgDefaults": { "type": "string", "minLength": 1 },
        "iconOnlyControl": { "type": "string", "minLength": 1 },
        "informative": { "type": "string", "minLength": 1 },
        "decorative": { "type": "string", "minLength": 1 },
        "contrast": { "type": "string", "minLength": 1 }
      }
    },
    "icons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "canonicalName", "label", "aliases", "style", "defaultSize", "directionality", "meaning"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "canonicalName": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "style": { "enum": ["stroke", "solid", "mixed", "brand"] },
          "defaultSize": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "directionality": { "enum": ["neutral", "mirror-in-rtl", "brand-fixed"] },
          "meaning": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
