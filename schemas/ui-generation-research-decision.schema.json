{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.local/schemas/ui-generation-research-decision.schema.json",
  "title": "Meridian UI Generation Research Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "id",
    "title",
    "status",
    "category",
    "question",
    "scope",
    "triggers",
    "constraints",
    "criteria",
    "candidates",
    "evidence",
    "spikes",
    "decision"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "0.1.0" },
    "kind": { "const": "ui-generation-research-decision" },
    "id": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/nonEmpty" },
    "status": { "enum": ["researching", "decision-ready", "approved", "superseded"] },
    "category": { "$ref": "#/$defs/category" },
    "question": { "$ref": "#/$defs/nonEmpty" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["milestone", "summary", "inScope", "outOfScope"],
      "properties": {
        "milestone": { "type": "string", "pattern": "^M[0-7](?:\\.[0-9]+)?$" },
        "summary": { "$ref": "#/$defs/nonEmpty" },
        "inScope": { "$ref": "#/$defs/stringList" },
        "outOfScope": { "$ref": "#/$defs/stringList" }
      }
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "new-architecture",
          "new-api",
          "new-dependency",
          "ecosystem-change",
          "accessibility-or-safety",
          "licensing",
          "security",
          "benchmark-needed",
          "conflicting-guidance",
          "uncertainty"
        ]
      }
    },
    "constraints": { "$ref": "#/$defs/stringList" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "spikes": {
      "type": "array",
      "items": { "$ref": "#/$defs/spike" }
    },
    "decision": { "$ref": "#/$defs/decision" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "nonEmpty": { "type": "string", "pattern": ".*\\S.*" },
    "stringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "category": {
      "enum": [
        "architecture",
        "schema-contract",
        "dependency",
        "design-system-adapter",
        "runtime",
        "browser-quality",
        "accessibility",
        "governance",
        "security",
        "licensing"
      ]
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "weight", "measurement"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "description": { "$ref": "#/$defs/nonEmpty" },
        "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
        "measurement": {
          "enum": ["document-review", "contract-analysis", "spike", "benchmark", "browser-evaluation", "manual-evaluation"]
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionId", "score", "confidence", "evidenceRefs", "spikeRefs", "notes"],
      "properties": {
        "criterionId": { "$ref": "#/$defs/id" },
        "score": { "type": ["integer", "null"], "minimum": 0, "maximum": 5 },
        "confidence": { "enum": ["low", "medium", "high"] },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "spikeRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "notes": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "officialUrl",
        "disposition",
        "license",
        "evidenceRefs",
        "assessments",
        "limitations",
        "eliminationReason"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "version": { "type": ["string", "null"] },
        "officialUrl": { "type": "string", "pattern": "^https://" },
        "disposition": { "enum": ["candidate", "shortlisted", "eliminated"] },
        "license": { "$ref": "#/$defs/nonEmpty" },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "assessments": {
          "type": "array",
          "items": { "$ref": "#/$defs/assessment" }
        },
        "limitations": { "$ref": "#/$defs/stringList" },
        "eliminationReason": { "type": ["string", "null"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "url",
        "sourceType",
        "authority",
        "publisher",
        "accessedAt",
        "candidateRefs",
        "criterionRefs",
        "summary",
        "limitations"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "url": { "type": "string", "pattern": "^https://" },
        "sourceType": {
          "enum": [
            "standard",
            "official-guideline",
            "official-documentation",
            "official-repository",
            "license",
            "security-advisory",
            "research-paper",
            "secondary-analysis"
          ]
        },
        "authority": { "enum": ["primary", "secondary"] },
        "publisher": { "$ref": "#/$defs/nonEmpty" },
        "accessedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "candidateRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "criterionRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "summary": { "$ref": "#/$defs/nonEmpty" },
        "limitations": { "$ref": "#/$defs/stringList" }
      }
    },
    "spike": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "candidateRefs",
        "hypothesis",
        "fixtureRefs",
        "commands",
        "measurements",
        "findings",
        "artifactRefs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["planned", "in-progress", "complete", "cancelled"] },
        "candidateRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "hypothesis": { "$ref": "#/$defs/nonEmpty" },
        "fixtureRefs": { "$ref": "#/$defs/stringList" },
        "commands": { "$ref": "#/$defs/stringList" },
        "measurements": { "$ref": "#/$defs/stringList" },
        "findings": { "$ref": "#/$defs/stringList" },
        "artifactRefs": { "$ref": "#/$defs/stringList" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorType", "actorId", "approvedAt", "notes"],
      "properties": {
        "actorType": { "enum": ["human", "ai"] },
        "actorId": { "$ref": "#/$defs/nonEmpty" },
        "approvedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
        "notes": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "recommendedCandidateId",
        "rationale",
        "tradeoffs",
        "rejectedCandidateIds",
        "unresolvedItems",
        "revisitTriggers",
        "approval"
      ],
      "properties": {
        "status": { "enum": ["pending", "recommended", "approved", "superseded"] },
        "recommendedCandidateId": { "type": ["string", "null"] },
        "rationale": { "type": "string" },
        "tradeoffs": { "$ref": "#/$defs/stringList" },
        "rejectedCandidateIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "unresolvedItems": { "$ref": "#/$defs/stringList" },
        "revisitTriggers": { "$ref": "#/$defs/stringList" },
        "approval": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["actorType", "actorId", "approvedAt", "notes"],
          "properties": {
            "actorType": { "enum": ["human", "ai"] },
            "actorId": { "$ref": "#/$defs/nonEmpty" },
            "approvedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
            "notes": { "$ref": "#/$defs/nonEmpty" }
          }
        }
      }
    }
  }
}
