{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.local/schemas/requirement-allocation.schema.json",
  "title": "Meridian Requirement Allocation",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "source", "requirements", "allocations", "coverage"],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "source": { "$ref": "#/$defs/source" },
    "requirements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/requirement" } },
    "allocations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/allocation" } },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "allocated", "unallocatedRequirementRefs"],
      "properties": {
        "required": { "type": "integer", "minimum": 1 },
        "allocated": { "type": "integer", "minimum": 0 },
        "unallocatedRequirementRefs": { "$ref": "#/$defs/idList" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256-[a-f0-9]{64}$" },
    "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "id", "status", "revision", "createdAt"],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "kind": { "const": "requirement-allocation" },
        "id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["draft", "ready-for-review", "approved", "superseded"] },
        "revision": { "type": "integer", "minimum": 1 },
        "createdAt": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designBriefRef", "designBriefDigest"],
      "properties": {
        "designBriefRef": { "$ref": "#/$defs/nonEmpty" },
        "designBriefDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "kind", "priority", "sourceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "enum": ["task", "constraint", "risk-control", "state", "quality"] },
        "priority": { "enum": ["critical", "high", "medium", "low"] },
        "sourceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirementRef", "responsibilityRef", "placement", "rationale"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "requirementRef": { "$ref": "#/$defs/id" },
        "responsibilityRef": { "$ref": "#/$defs/id" },
        "placement": { "enum": ["persistent", "workflow", "transient", "background"] },
        "rationale": { "$ref": "#/$defs/nonEmpty" }
      }
    }
  }
}
