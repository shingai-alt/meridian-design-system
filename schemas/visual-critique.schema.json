{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.local/schemas/visual-critique.schema.json",
  "title": "Meridian Screenshot-grounded Visual Critique",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "conceptId", "rubricId", "captureManifestRef", "reviewer", "reviewedAt", "candidateReviews"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "0.1.0" },
    "conceptId": { "type": "string" },
    "rubricId": { "type": "string" },
    "captureManifestRef": { "const": "examples/generated/visual-review/manifest.json" },
    "reviewer": { "type": "object", "additionalProperties": false, "required": ["kind", "name"], "properties": {
      "kind": { "enum": ["multimodal-ai", "human"] }, "name": { "type": "string", "minLength": 1 }
    } },
    "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "candidateReviews": { "type": "array", "minItems": 4, "maxItems": 4, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateId", "evidence", "rubricScores", "findings", "summary"],
      "properties": {
        "candidateId": { "type": "string" },
        "evidence": { "type": "array", "minItems": 2, "maxItems": 2, "items": {
          "type": "object", "additionalProperties": false, "required": ["viewport", "path", "digest"],
          "properties": {
            "viewport": { "enum": ["desktop", "mobile"] },
            "path": { "type": "string" },
            "digest": { "type": "string", "pattern": "^sha256-[a-f0-9]{64}$" }
          }
        } },
        "rubricScores": { "type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["criterion", "score", "rationale"],
          "properties": {
            "criterion": { "type": "string" }, "score": { "type": "integer", "minimum": 1, "maximum": 5 }, "rationale": { "type": "string", "minLength": 1 }
          }
        } },
        "findings": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["criterion", "severity", "region", "finding"],
          "properties": {
            "criterion": { "type": "string" }, "severity": { "enum": ["major", "minor", "note"] }, "region": { "type": "string" }, "finding": { "type": "string", "minLength": 1 }
          }
        } },
        "summary": { "type": "string", "minLength": 1 }
      }
    } }
  }
}
