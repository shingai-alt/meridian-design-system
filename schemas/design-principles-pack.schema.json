{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.local/schemas/design-principles-pack.schema.json",
  "title": "Meridian Screen-specific Design Principles",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "conceptId", "referenceManifestRef", "principles", "antiPatterns"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "0.1.0" },
    "id": { "type": "string", "minLength": 1 },
    "conceptId": { "type": "string", "minLength": 1 },
    "referenceManifestRef": { "type": "string", "pattern": "^research/references/[a-z0-9._/-]+\\.json$" },
    "principles": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/principle" } },
    "antiPatterns": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/antiPattern" } }
  },
  "$defs": {
    "principle": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "observation", "principle", "condition", "application", "confidence", "evidenceRefs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
        "observation": { "type": "string", "minLength": 1 },
        "principle": { "type": "string", "minLength": 1 },
        "condition": { "type": "string", "minLength": 1 },
        "application": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["high", "medium", "low"] },
        "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "antiPattern": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "pattern", "reason", "evidenceRefs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
        "pattern": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}
