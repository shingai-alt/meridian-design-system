{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.local/schemas/system-registry.schema.json",
  "title": "Meridian Refinement Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowDoc", "reviewRecordSchema", "researchPolicy", "domains"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "workflowDoc": { "type": "string" },
    "reviewRecordSchema": { "type": "string" },
    "researchPolicy": { "type": "string" },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/domain" }
    }
  },
  "$defs": {
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "order", "template", "routePrefix", "artifactTemplates", "items"],
      "properties": {
        "id": { "enum": ["overview", "foundations", "tokens", "components"] },
        "title": { "type": "string" },
        "order": { "type": "integer" },
        "template": { "type": "string" },
        "routePrefix": { "type": "string" },
        "artifactTemplates": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/item" }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "order", "route", "dependsOn", "sources", "reviewRecord"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "order": { "type": "integer" },
        "route": { "type": "string", "minLength": 1 },
        "dependsOn": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "reviewRecord": { "type": ["string", "null"] }
      }
    }
  }
}
