{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.local/schemas/accessibility.schema.json",
  "title": "Meridian Accessibility Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "standard", "policy", "targetSize", "liveRegions", "disabledState", "requirements", "qualityGates"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string", "minLength": 1 },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "conformanceLevel", "url"],
      "properties": {
        "name": { "const": "WCAG" },
        "version": { "const": "2.2" },
        "conformanceLevel": { "const": "AA" },
        "url": { "type": "string", "pattern": "^https://" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "registryScope", "conformance", "exceptions", "releaseBlocker"],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "registryScope": { "type": "string", "minLength": 1 },
        "conformance": { "type": "string", "minLength": 1 },
        "exceptions": { "type": "string", "minLength": 1 },
        "releaseBlocker": { "type": "string", "minLength": 1 }
      }
    },
    "targetSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumCssPx", "preferredCssPx", "minimumRule", "preferredRule"],
      "properties": {
        "minimumCssPx": { "type": "integer", "minimum": 24, "maximum": 44 },
        "preferredCssPx": { "type": "integer", "minimum": 44, "maximum": 64 },
        "minimumRule": { "type": "string", "minLength": 1 },
        "preferredRule": { "type": "string", "minLength": 1 }
      }
    },
    "liveRegions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["polite", "assertive", "focus"],
      "properties": {
        "polite": { "type": "string", "minLength": 1 },
        "assertive": { "type": "string", "minLength": 1 },
        "focus": { "type": "string", "minLength": 1 }
      }
    },
    "disabledState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native", "discoverable", "explanation"],
      "properties": {
        "native": { "type": "string", "minLength": 1 },
        "discoverable": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 1 }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "principle", "level", "criteria", "appliesTo", "requirement", "verification", "exceptions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "principle": { "enum": ["perceivable", "operable", "understandable", "robust"] },
          "level": { "enum": ["A", "AA", "AAA", "recommended"] },
          "criteria": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" } },
          "appliesTo": { "type": "string", "minLength": 1 },
          "requirement": { "type": "string", "minLength": 1 },
          "verification": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "exceptions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "qualityGates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "owner", "checks"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "stage": { "enum": ["contract", "implementation", "automated", "manual", "release"] },
          "owner": { "type": "string", "minLength": 1 },
          "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
