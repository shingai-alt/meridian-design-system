{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.local/schemas/visual-candidates.schema.json",
  "title": "Meridian Visual Design Candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "conceptId", "rubricRef", "baselineId", "candidates", "comparisons"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "conceptId": { "type": "string" },
    "rubricRef": { "type": "string" },
    "baselineId": { "type": "string" },
    "candidates": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "kind", "strategyRef", "principleRefs", "hypothesis", "taskModel", "hierarchy", "layout", "primaryAction", "tradeoffs", "critiqueStatus", "repairRounds", "provisionalScores"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["baseline", "candidate"] },
          "strategyRef": { "type": "string", "minLength": 1 },
          "principleRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "hypothesis": { "type": "string", "minLength": 1 },
          "taskModel": { "type": "string", "minLength": 1 },
          "hierarchy": { "type": "array", "minItems": 3, "items": { "type": "string" } },
          "layout": { "enum": ["baseline-cards", "task-focus", "context-aside", "guided-flow"] },
          "primaryAction": { "type": "string", "minLength": 1 },
          "tradeoffs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "critiqueStatus": { "enum": ["not-required", "repair-not-required", "repaired"] },
          "repairRounds": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["round", "findings", "repairs", "unresolvedFindings"],
              "properties": {
                "round": { "type": "integer", "minimum": 1, "maximum": 2 },
                "findings": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "criterion", "severity", "region", "finding"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "criterion": { "type": "string" },
                      "severity": { "enum": ["major", "minor", "note"] },
                      "region": { "type": "string" },
                      "finding": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "repairs": { "type": "array", "minItems": 1, "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["findingIds", "change"],
                  "properties": {
                    "findingIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
                    "change": { "type": "string", "minLength": 1 }
                  }
                } },
                "unresolvedFindings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "criterion", "severity", "region", "finding"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "criterion": { "type": "string" },
                      "severity": { "enum": ["major", "minor", "note"] },
                      "region": { "type": "string" },
                      "finding": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          },
          "provisionalScores": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["criterion", "score", "rationale"],
              "properties": {
                "criterion": { "type": "string" },
                "score": { "type": "integer", "minimum": 1, "maximum": 5 },
                "rationale": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "left", "right"],
        "properties": {
          "id": { "type": "string" },
          "left": { "type": "string" },
          "right": { "type": "string" }
        }
      }
    }
  }
}
