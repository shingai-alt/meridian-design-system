{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.local/schemas/browser-qa-evidence.schema.json",
  "title": "Meridian UI Generation Browser QA Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "meta", "environment", "source", "stressCoverage", "scenarios", "summary"],
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "id", "pilotId", "status", "generatedAt"],
      "properties": {
        "schemaVersion": { "const": "0.1.0" },
        "kind": { "const": "browser-qa-evidence" },
        "id": { "$ref": "#/$defs/id" },
        "pilotId": { "$ref": "#/$defs/id" },
        "status": { "enum": ["pass", "blocked"] },
        "generatedAt": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "browserVersion", "playwrightVersion", "platform", "headless"],
      "properties": {
        "engine": { "const": "chromium" },
        "browserVersion": { "type": "string", "minLength": 1 },
        "playwrightVersion": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "headless": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "generationManifest", "reviewUi", "reviewModel", "usageManifest"],
      "properties": {
        "policy": { "$ref": "#/$defs/sourceBinding" },
        "generationManifest": { "$ref": "#/$defs/sourceBinding" },
        "reviewUi": { "$ref": "#/$defs/sourceBinding" },
        "reviewModel": { "$ref": "#/$defs/sourceBinding" },
        "usageManifest": { "$ref": "#/$defs/sourceBinding" }
      }
    },
    "stressCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["longJapanese", "highDensity"],
      "properties": {
        "longJapanese": { "$ref": "#/$defs/stressResult" },
        "highDensity": { "$ref": "#/$defs/stressResult" }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "completed", "passed", "blocked", "criticalFindings", "majorFindings", "minorFindings"],
      "properties": {
        "expected": { "type": "integer", "minimum": 1 },
        "completed": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "criticalFindings": { "type": "integer", "minimum": 0 },
        "majorFindings": { "type": "integer", "minimum": 0 },
        "minorFindings": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
    "digest": { "type": "string", "pattern": "^sha256-[a-f0-9]{64}$" },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "stressResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observed", "required", "sourceRefs"],
      "properties": {
        "status": { "enum": ["pass", "fail"] },
        "observed": { "type": "integer", "minimum": 0 },
        "required": { "type": "integer", "minimum": 0 },
        "sourceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "screenRef", "state", "viewport", "dimensions", "screenshot", "checks", "findings", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "screenRef": { "$ref": "#/$defs/id" },
        "state": { "enum": ["default", "loading", "empty", "error", "permission"] },
        "viewport": { "enum": ["desktop", "tablet", "mobile"] },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 320 },
            "height": { "type": "integer", "minimum": 600 }
          }
        },
        "screenshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "digest", "width", "height"],
          "properties": {
            "ref": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "#/$defs/digest" },
            "width": { "type": "integer", "minimum": 320 },
            "height": { "type": "integer", "minimum": 1 }
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["consoleErrors", "pageErrors", "horizontalOverflow", "duplicateIds", "danglingAriaRefs", "unnamedControls", "keyboard", "stateSignal", "runtimeProvenance"],
          "properties": {
            "consoleErrors": { "type": "array", "items": { "type": "string" } },
            "pageErrors": { "type": "array", "items": { "type": "string" } },
            "horizontalOverflow": { "type": "boolean" },
            "duplicateIds": { "type": "array", "items": { "type": "string" } },
            "danglingAriaRefs": { "type": "array", "items": { "type": "string" } },
            "unnamedControls": { "type": "array", "items": { "type": "string" } },
            "keyboard": {
              "type": "object",
              "additionalProperties": false,
              "required": ["expected", "reached", "missing", "missingVisibleFocus", "obscured"],
              "properties": {
                "expected": { "type": "integer", "minimum": 0 },
                "reached": { "type": "integer", "minimum": 0 },
                "missing": { "type": "array", "items": { "type": "string" } },
                "missingVisibleFocus": { "type": "array", "items": { "type": "string" } },
                "obscured": { "type": "array", "items": { "type": "string" } }
              }
            },
            "stateSignal": {
              "type": "object",
              "additionalProperties": false,
              "required": ["expected", "observed", "pass"],
              "properties": {
                "expected": { "type": "string" },
                "observed": { "type": "integer", "minimum": 0 },
                "pass": { "type": "boolean" }
              }
            },
            "runtimeProvenance": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rendered", "unknown", "incomplete"],
              "properties": {
                "rendered": { "type": "integer", "minimum": 0 },
                "unknown": { "type": "array", "items": { "type": "string" } },
                "incomplete": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "status": { "enum": ["pass", "blocked"] }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "layer", "code", "message", "lockedStructureImpact"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "severity": { "enum": ["critical", "major", "minor"] },
        "layer": { "enum": ["generation-manifest", "layout-recipe", "component-runtime", "content", "browser-environment"] },
        "code": { "$ref": "#/$defs/id" },
        "message": { "type": "string", "minLength": 1 },
        "lockedStructureImpact": { "const": false }
      }
    }
  }
}
