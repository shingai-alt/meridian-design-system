{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.local/schemas/product-ui-pattern-registry.schema.json",
  "title": "Meridian Product UI Pattern Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "principles", "structuralDimensions", "directionPolicy", "patterns", "evidence"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "kind": { "const": "product-ui-pattern-registry" },
    "principles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "structuralDimensions": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "enum": ["task-model", "information-architecture", "navigation", "disclosure", "action-model", "screen-boundary"] } },
    "directionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum", "minimumPairwiseDifferences", "humanApprovalRole"],
      "properties": {
        "minimum": { "const": 2 },
        "maximum": { "const": 3 },
        "minimumPairwiseDifferences": { "type": "integer", "minimum": 1 },
        "humanApprovalRole": { "const": "design-owner" }
      }
    },
    "patterns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pattern" } },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "stringList": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "problem", "taskModel", "applicableWhen", "avoidWhen", "requiredBehaviors", "evidenceRefs", "maturity"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "problem": { "$ref": "#/$defs/nonEmpty" },
        "taskModel": { "enum": ["compare", "process-one", "create", "review", "monitor", "configure", "explore"] },
        "applicableWhen": { "$ref": "#/$defs/stringList" },
        "avoidWhen": { "$ref": "#/$defs/stringList" },
        "requiredBehaviors": { "$ref": "#/$defs/stringList" },
        "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "maturity": { "enum": ["experimental", "candidate", "supported", "deprecated"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "url", "observation", "accessedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["official-design-system", "standard", "internal-pilot"] },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "url": { "type": ["string", "null"] },
        "observation": { "$ref": "#/$defs/nonEmpty" },
        "accessedAt": { "$ref": "#/$defs/nonEmpty" }
      }
    }
  }
}
