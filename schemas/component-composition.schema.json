{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.local/schemas/component-composition.schema.json",
  "title": "Meridian Component Composition Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "conceptId", "translationPackDigest", "patterns", "nodes", "decisions", "exceptions"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "conceptId": { "type": "string" },
    "translationPackDigest": { "type": "string", "pattern": "^sha256-[a-f0-9]{64}$" },
    "patterns": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "instanceId", "props", "allowedVariants", "allowedStates", "contentRef", "decisionRef"],
        "properties": {
          "component": { "type": "string" },
          "instanceId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
          "repeat": { "enum": ["scenario.rows", "prototype.actions"] },
          "props": { "type": "object", "additionalProperties": true },
          "allowedVariants": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "allowedStates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "contentRef": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
          "decisionRef": { "type": "string" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "component", "reason", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "pattern": "^decision\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
          "component": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 },
          "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "reason", "scope", "requestedCapability", "alternativesConsidered", "owner", "expiresAt", "humanApprovalRequired", "status"],
        "properties": {
          "id": { "type": "string" },
          "type": { "const": "component-exception" },
          "reason": { "type": "string", "minLength": 1 },
          "scope": { "type": "string" },
          "requestedCapability": { "type": "string", "minLength": 1 },
          "alternativesConsidered": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "owner": { "type": "string", "minLength": 1 },
          "expiresAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "humanApprovalRequired": { "const": true },
          "status": { "enum": ["proposed", "approved", "rejected"] },
          "approvalRef": { "type": "string" }
        }
      }
    }
  }
}
