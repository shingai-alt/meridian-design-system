{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.local/schemas/implementation-readiness.schema.json",
  "title": "Meridian Component Implementation Readiness Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "description", "requiredCriteria", "invariants", "stableExitCriteria"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "requiredCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "invariants": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "stableExitCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
