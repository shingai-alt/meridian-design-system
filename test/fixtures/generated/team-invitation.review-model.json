  "decisions": [
    {
      "id": "decision-manage-structure",
      "reason": "Member管理責務をstatus listと招待開始actionへ限定する。",
      "sourceRefs": [
        "responsibility_manage",
        "selection_status_management"
      ]
    },
    {
      "id": "decision-manage-status",
      "reason": "Pending状態、期限、対象別actionを同じreading orderで比較する。",
      "sourceRefs": [
        "capability_invitation_statuses",
        "selection_status_management"
      ]
    },
    {
      "id": "decision-primary-action",
      "reason": "各責務の完了点に一つの主要actionを置く。",
      "sourceRefs": [
        "capability_primary_actions",
        "direction_dedicated_stages"
      ]
    },
    {
      "id": "decision-compose-structure",
      "reason": "複数宛先の比較編集を専用責務として確保する。",
      "sourceRefs": [
        "responsibility_compose",
        "selection_batch_create"
      ]
    },
    {
      "id": "decision-stage-progress",
      "reason": "入力、確認、結果の現在地と到達可能性を示す。",
      "sourceRefs": [
        "capability_stage_progress",
        "direction_dedicated_stages"
      ]
    },
    {
      "id": "decision-batch-editor",
      "reason": "宛先ごとのEmailとRoleを対応付けて修正可能にする。",
      "sourceRefs": [
        "capability_recipient_batch",
        "selection_batch_create"
      ]
    },
    {
      "id": "decision-review-structure",
      "reason": "送信確定を入力から分離した一責務のsectionにする。",
      "sourceRefs": [
        "responsibility_review",
        "selection_review"
      ]
    },
    {
      "id": "decision-review-confirmation",
      "reason": "宛先と高権限の影響を送信前に一度確認する。",
      "sourceRefs": [
        "capability_review_confirmation",
        "selection_review"
      ]
    },
    {
      "id": "decision-result-structure",
      "reason": "送信結果の理解と失敗対象の回復だけを扱う。",
      "sourceRefs": [
        "responsibility_result",
        "selection_partial_result"
      ]
    },
    {
      "id": "decision-result-feedback",
      "reason": "成功済み対象を保持しながら失敗対象の次行動を示す。",
      "sourceRefs": [
        "capability_result_feedback",
        "selection_partial_result"
      ]
    }
  ],
