{
  "duration": {
    "instant": { "$value": "50ms", "$type": "duration" },
    "fast": { "$value": "120ms", "$type": "duration" },
    "normal": { "$value": "180ms", "$type": "duration" },
    "slow": { "$value": "240ms", "$type": "duration" },
    "slower": { "$value": "320ms", "$type": "duration" }
  },
  "easing": {
    "standard": { "$value": "cubic-bezier(.2,0,0,1)", "$type": "cubicBezier" },
    "enter": { "$value": "cubic-bezier(0,0,.2,1)", "$type": "cubicBezier" },
    "exit": { "$value": "cubic-bezier(.4,0,1,1)", "$type": "cubicBezier" },
    "emphasized": { "$value": "cubic-bezier(.2,0,0,1.08)", "$type": "cubicBezier" }
  }
}
