{
  "$schema": "../schemas/ui-generation-session-policy.schema.json",
  "schemaVersion": "0.1.0",
  "artifactTypes": [
    { "id": "user_request", "ownership": "canonical", "description": "The original user intent and supplied constraints." },
    { "id": "project_context", "ownership": "evidence", "description": "Evidence-backed inspection of the target project and its existing design system." },
    { "id": "design_brief", "ownership": "canonical", "description": "Structured actors, goals, tasks, entities, constraints, risks, assumptions, and unknowns." },
    { "id": "requirement_allocation", "ownership": "canonical", "description": "Mapping from every requirement to one or more product surfaces." },
    { "id": "screen_responsibilities", "ownership": "canonical", "description": "Responsibility, primary task, and exclusions for every screen." },
    { "id": "pattern_selection", "ownership": "canonical", "description": "Selected product UI patterns with evidence and rejected alternatives." },
    { "id": "direction_set", "ownership": "canonical", "description": "Two or three structurally distinct design directions." },
    { "id": "capability_plan", "ownership": "canonical", "description": "Library-independent component capabilities required by the approved direction." },
    { "id": "adapter_resolution", "ownership": "derived", "description": "Deterministic resolution of capabilities to project or external adapter components." },
    { "id": "generation_manifest", "ownership": "derived", "description": "Inputs, versions, provenance, output paths, and deterministic generation parameters." },
    { "id": "review_ui", "ownership": "derived", "description": "Generated interactive review surface." },
    { "id": "browser_quality_report", "ownership": "evidence", "description": "Desktop, tablet, and mobile task, state, accessibility, and visual findings." },
    { "id": "structured_feedback", "ownership": "canonical", "description": "Human or automated findings classified by severity and responsible design layer." },
    { "id": "repair_plan", "ownership": "canonical", "description": "Approved or deterministic corrections routed to the responsible source layer." },
    { "id": "generation_report", "ownership": "derived", "description": "Final provenance, coverage, decisions, unresolved items, and quality summary." }
  ],
  "states": [
    { "id": "created", "phase": "intake", "terminal": false, "requiredArtifactTypes": ["user_request"], "description": "The session exists and preserves the original request." },
    { "id": "project_inspected", "phase": "inspection", "terminal": false, "requiredArtifactTypes": ["user_request", "project_context"], "description": "Target project evidence and current design-system context are available." },
    { "id": "clarifying", "phase": "intake", "terminal": false, "requiredArtifactTypes": ["user_request", "project_context", "design_brief"], "description": "Blocking structural unknowns are being resolved." },
    { "id": "brief_review", "phase": "intake", "terminal": false, "requiredArtifactTypes": ["user_request", "project_context", "design_brief"], "description": "The structured brief is waiting for human acceptance." },
    { "id": "direction_planning", "phase": "structure", "terminal": false, "requiredArtifactTypes": ["user_request", "project_context", "design_brief"], "description": "Requirements, screen responsibilities, patterns, and alternatives are being produced." },
    { "id": "direction_review", "phase": "structure", "terminal": false, "requiredArtifactTypes": ["user_request", "project_context", "design_brief", "requirement_allocation", "screen_responsibilities", "pattern_selection", "direction_set"], "description": "Structurally distinct directions are waiting for a human selection." },
    { "id": "resolving_components", "phase": "resolution", "terminal": false, "requiredArtifactTypes": ["user_request", "project_context", "design_brief", "requirement_allocation", "screen_responsibilities", "pattern_selection", "direction_set", "capability_plan"], "description": "Approved structure is resolved through project-first Design System adapters." },
    { "id": "generating_review", "phase": "generation", "terminal": false, "requiredArtifactTypes": ["user_request", "project_context", "design_brief", "requirement_allocation", "screen_responsibilities", "pattern_selection", "direction_set", "capability_plan", "adapter_resolution"], "description": "The deterministic review artifact is being generated." },
    { "id": "evaluating_quality", "phase": "quality", "terminal": false, "requiredArtifactTypes": ["user_request", "project_context", "design_brief", "requirement_allocation", "screen_responsibilities", "pattern_selection", "direction_set", "capability_plan", "adapter_resolution", "generation_manifest", "review_ui"], "description": "Browser and task quality are being evaluated at required viewports and states." },
    { "id": "human_review", "phase": "review", "terminal": false, "requiredArtifactTypes": ["user_request", "project_context", "design_brief", "requirement_allocation", "screen_responsibilities", "pattern_selection", "direction_set", "capability_plan", "adapter_resolution", "generation_manifest", "review_ui", "browser_quality_report"], "description": "A quality-gated result is waiting for human review." },
    { "id": "repairing", "phase": "repair", "terminal": false, "requiredArtifactTypes": ["user_request", "project_context", "design_brief", "requirement_allocation", "screen_responsibilities", "pattern_selection", "direction_set", "capability_plan", "adapter_resolution", "generation_manifest", "review_ui", "browser_quality_report", "structured_feedback", "repair_plan"], "description": "Findings are routed back to the responsible artifact layer." },
    { "id": "completed", "phase": "complete", "terminal": true, "requiredArtifactTypes": ["user_request", "project_context", "design_brief", "requirement_allocation", "screen_responsibilities", "pattern_selection", "direction_set", "capability_plan", "adapter_resolution", "generation_manifest", "review_ui", "browser_quality_report", "generation_report"], "description": "Required coverage, provenance, quality gates, and final human approval are complete." },
    { "id": "cancelled", "phase": "terminal", "terminal": true, "requiredArtifactTypes": ["user_request"], "description": "The session was intentionally cancelled without claiming completion." },
    { "id": "failed", "phase": "terminal", "terminal": true, "requiredArtifactTypes": ["user_request"], "description": "The session stopped on a recorded unrecoverable failure without claiming completion." }
  ],
  "transitions": [
    { "id": "inspect_project", "from": "created", "to": "project_inspected", "gate": "automatic", "requiredApprovalRole": null, "requiredArtifactTypes": ["project_context"] },
    { "id": "request_clarification", "from": "project_inspected", "to": "clarifying", "gate": "automatic", "requiredApprovalRole": null, "requiredArtifactTypes": ["design_brief"] },
    { "id": "submit_brief", "from": "project_inspected", "to": "brief_review", "gate": "automatic", "requiredApprovalRole": null, "requiredArtifactTypes": ["design_brief"] },
    { "id": "resubmit_brief", "from": "clarifying", "to": "brief_review", "gate": "automatic", "requiredApprovalRole": null, "requiredArtifactTypes": ["design_brief"] },
    { "id": "revise_brief", "from": "brief_review", "to": "clarifying", "gate": "human", "requiredApprovalRole": "product-owner", "requiredArtifactTypes": ["design_brief"] },
    { "id": "approve_brief", "from": "brief_review", "to": "direction_planning", "gate": "human", "requiredApprovalRole": "product-owner", "requiredArtifactTypes": ["design_brief"] },
    { "id": "submit_directions", "from": "direction_planning", "to": "direction_review", "gate": "automatic", "requiredApprovalRole": null, "requiredArtifactTypes": ["requirement_allocation", "screen_responsibilities", "pattern_selection", "direction_set"] },
    { "id": "revise_directions", "from": "direction_review", "to": "direction_planning", "gate": "human", "requiredApprovalRole": "design-owner", "requiredArtifactTypes": ["direction_set"] },
    { "id": "approve_direction", "from": "direction_review", "to": "resolving_components", "gate": "human", "requiredApprovalRole": "design-owner", "requiredArtifactTypes": ["direction_set", "capability_plan"] },
    { "id": "resolve_components", "from": "resolving_components", "to": "generating_review", "gate": "automatic", "requiredApprovalRole": null, "requiredArtifactTypes": ["adapter_resolution"] },
    { "id": "generate_review", "from": "generating_review", "to": "evaluating_quality", "gate": "automatic", "requiredApprovalRole": null, "requiredArtifactTypes": ["generation_manifest", "review_ui"] },
    { "id": "quality_pass", "from": "evaluating_quality", "to": "human_review", "gate": "automatic", "requiredApprovalRole": null, "requiredArtifactTypes": ["browser_quality_report"] },
    { "id": "quality_repair", "from": "evaluating_quality", "to": "repairing", "gate": "automatic", "requiredApprovalRole": null, "requiredArtifactTypes": ["browser_quality_report", "structured_feedback", "repair_plan"] },
    { "id": "request_repair", "from": "human_review", "to": "repairing", "gate": "human", "requiredApprovalRole": "review-owner", "requiredArtifactTypes": ["structured_feedback", "repair_plan"] },
    { "id": "repair_ready", "from": "repairing", "to": "generating_review", "gate": "automatic", "requiredApprovalRole": null, "requiredArtifactTypes": ["repair_plan"] },
    { "id": "approve_result", "from": "human_review", "to": "completed", "gate": "human", "requiredApprovalRole": "review-owner", "requiredArtifactTypes": ["generation_report"] },
    { "id": "cancel_session", "from": "any_active_state", "to": "cancelled", "gate": "human", "requiredApprovalRole": "session-owner", "requiredArtifactTypes": ["user_request"] },
    { "id": "fail_session", "from": "any_active_state", "to": "failed", "gate": "automatic", "requiredApprovalRole": null, "requiredArtifactTypes": ["user_request"] }
  ],
  "integrity": {
    "digestAlgorithm": "sha256",
    "pathScope": "repository-relative",
    "currentDigestRequired": true,
    "artifactSchemaVersionRequired": true,
    "revisionMonotonic": true
  },
  "invariants": [
    "The current state equals the destination of the final transition record.",
    "Every current artifact has a repository-relative path, explicit schema version, revision, ownership, and current SHA-256 digest.",
    "A state cannot be entered until its required artifact types and the transition-specific artifact types exist and are current.",
    "A human-gated transition requires a matching approved decision from a human with the required role.",
    "AI and system actors cannot author human approval records.",
    "Approval records bind the exact digests reviewed so later artifact changes make the approval stale.",
    "Artifact revisions for the same artifact identity increase monotonically and superseded content is never treated as current.",
    "Completed is the only successful terminal state and requires a generation report plus final human approval.",
    "Repair returns to the responsible source layer through explicit feedback and a repair plan; it does not silently patch generated output.",
    "Changing this state machine or its artifact requirements requires a versioned policy revision."
  ]
}
