    { "id": "folder", "canonicalName": "folder", "label": "フォルダ", "aliases": ["directory", "group"], "style": "stroke", "defaultSize": "sm", "directionality": "neutral", "meaning": "Directory or content group" },
    { "id": "file", "canonicalName": "file", "label": "ファイル", "aliases": ["document", "page"], "style": "stroke", "defaultSize": "sm", "directionality": "neutral", "meaning": "File or document" },
    { "id": "send", "canonicalName": "arrow-up", "label": "送信", "aliases": ["submit", "send"], "style": "stroke", "defaultSize": "sm", "directionality": "neutral", "meaning": "Prompt or messageを送信" },
    { "id": "clip", "canonicalName": "paperclip", "label": "添付", "aliases": ["attach", "attachment"], "style": "stroke", "defaultSize": "sm", "directionality": "neutral", "meaning": "Fileを添付" },
    { "id": "bell", "canonicalName": "bell", "label": "通知", "aliases": ["notification", "alerts"], "style": "stroke", "defaultSize": "md", "directionality": "neutral", "meaning": "Notifications" },
    { "id": "github", "canonicalName": "github", "label": "GitHub", "aliases": ["repository", "source"], "style": "brand", "defaultSize": "md", "directionality": "brand-fixed", "meaning": "GitHub brand destination" },
    { "id": "arrowR", "canonicalName": "arrow-right", "label": "次へ", "aliases": ["forward", "continue"], "style": "stroke", "defaultSize": "sm", "directionality": "mirror-in-rtl", "meaning": "次のstepまたはdestination" },
    { "id": "dots", "canonicalName": "ellipsis", "label": "その他", "aliases": ["more", "overflow"], "style": "solid", "defaultSize": "sm", "directionality": "neutral", "meaning": "Overflow actions menu" },
    { "id": "cal", "canonicalName": "calendar", "label": "日付", "aliases": ["date", "schedule"], "style": "stroke", "defaultSize": "sm", "directionality": "neutral", "meaning": "Date or calendar picker" },
    { "id": "filter", "canonicalName": "filter", "label": "絞り込み", "aliases": ["refine", "funnel"], "style": "stroke", "defaultSize": "sm", "directionality": "neutral", "meaning": "Filter conditions" },
    { "id": "refresh", "canonicalName": "refresh", "label": "更新", "aliases": ["reload", "retry"], "style": "stroke", "defaultSize": "sm", "directionality": "neutral", "meaning": "Dataを再取得または再試行" },
    { "id": "cmd", "canonicalName": "command", "label": "コマンド", "aliases": ["shortcut", "command-key"], "style": "stroke", "defaultSize": "sm", "directionality": "neutral", "meaning": "Command menu or command key" },
    { "id": "zap", "canonicalName": "bolt", "label": "実行", "aliases": ["run", "automation"], "style": "stroke", "defaultSize": "sm", "directionality": "neutral", "meaning": "Fast action、run、automation" },
    { "id": "users", "canonicalName": "users", "label": "メンバー", "aliases": ["team", "people"], "style": "stroke", "defaultSize": "sm", "directionality": "neutral", "meaning": "People、member、team" },
    { "id": "gear", "canonicalName": "settings", "label": "設定", "aliases": ["preferences", "configuration"], "style": "stroke", "defaultSize": "sm", "directionality": "neutral", "meaning": "Settings or configuration" }
  ]
}
