{
  "$schema": "../../../schemas/component-contract.schema.json",
  "schemaVersion": "0.1.0",
  "id": "toast",
  "name": "Toast",
  "status": "draft",
  "category": "feedback",
  "description": "操作結果の一時的な通知。自動で消え、作業を妨げない。",
  "source": {
    "humanDoc": "components/toast.md",
    "registry": "js/components-registry.js#toast"
  },
  "intent": {
    "whenToUse": [
      "保存・作成・削除など操作の完了通知"
    ],
    "whenNotToUse": [
      "ユーザーの判断が必要な情報 → Dialog",
      "恒常的な警告 → Banner / Alert"
    ],
    "principles": [
      1,
      2,
      3,
      5,
      6
    ]
  },
  "anatomy": [
    {
      "part": "root",
      "required": true,
      "description": "Status message boundary."
    },
    {
      "part": "indicator",
      "required": false,
      "description": "Icon or shape that reinforces tone."
    },
    {
      "part": "message",
      "required": true,
      "description": "Concise status and recovery guidance."
    },
    {
      "part": "action",
      "required": false,
      "description": "Recovery, undo, or dismiss control."
    }
  ],
  "variants": {
    "success": {
      "intent": "完了または肯定的状態。",
      "tokenRefs": {},
      "states": {}
    },
    "info": {
      "intent": "中立的な補足情報。",
      "tokenRefs": {},
      "states": {}
    },
    "danger": {
      "intent": "破壊的または回復困難な操作・状態。",
      "tokenRefs": {},
      "states": {}
    }
  },
  "sizes": {},
  "states": [
    {
      "id": "default",
      "description": "通常状態。意味、label、valueを省略しない。",
      "requiredBehavior": [
        "通常状態。意味、label、valueを省略しない。"
      ]
    }
  ],
  "props": [
    {
      "name": "variant",
      "type": "\"success\" | \"info\" | \"danger\"",
      "required": false,
      "default": "success",
      "description": "意味と優先度を選ぶ。"
    },
    {
      "name": "title",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Title"
    },
    {
      "name": "body",
      "type": "string",
      "required": false,
      "default": null,
