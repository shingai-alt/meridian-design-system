{
  "$schema": "../../../schemas/component-contract.schema.json",
  "schemaVersion": "0.1.0",
  "contractVersion": "0.1.0",
  "runtime": {
    "compatibility": ">=0.1.0 <1.0.0",
    "rootElements": ["input"],
    "slots": ["control", "leading", "trailing"],
    "attributes": ["type", "value", "disabled", "readonly", "aria-invalid", "aria-labelledby", "aria-describedby"],
    "stateModel": ["native-attributes", "data-meridian-state"],
    "events": ["input", "change", "blur"],
    "relations": ["labelledby", "describedby", "error-message"],
    "provenance": ["component", "instance", "variant", "state", "contract-version", "runtime-version", "decision"]
  },
  "selectionRules": { "useWhen": ["短い自由入力を受け付ける。"], "avoidWhen": ["長文または有限選択肢には使わない。"], "alternatives": ["textarea", "select", "radio"] },
  "negativeExamples": [{ "pattern": "labelをplaceholderだけで代用する。", "reason": "入力後にaccessible labelが失われるため。", "ruleIds": ["INTERACTIVE_NAME_REQUIRED"] }],
  "requiredScenarios": ["default", "error", "disabled", "readonly", "focus"],
  "id": "text-field",
  "name": "Text Field",
  "status": "draft",
  "category": "forms",
  "description": "1 行のテキスト入力。ラベル・ヘルプ・エラーは Form Field と組み合わせる。",
  "source": {
    "humanDoc": "components/text-field.md",
    "registry": "js/components-registry.js#text-field"
  },
  "intent": {
    "whenToUse": [
      "短い自由入力(名前・URL・メール)"
    ],
    "whenNotToUse": [
      "長文 → Textarea",
      "限られた選択肢 → Select / Radio"
    ],
    "principles": [
      1,
      2,
      3,
      5,
      6
    ]
  },
  "anatomy": [
    {
      "part": "root",
      "required": true,
      "description": "Control boundary and focus indicator."
    },
    {
      "part": "control",
      "required": true,
      "description": "Native input or textarea that owns the value."
    },
    {
      "part": "adornment",
      "required": false,
      "description": "Prefix, suffix, clear, attachment, or submit action."
    },
    {
      "part": "message",
      "required": false,
      "description": "Help, count, loading, or validation feedback."
    }
  ],
  "variants": {
    "default": {
      "intent": "標準文脈。",
      "tokenRefs": {},
      "states": {}
    }
  },
  "sizes": {
    "sm": {
      "controlHeight": "--ctl-sm",
      "paddingInline": [
        "--sp-2",
        "--sp-2"
      ],
      "gap": "--sp-2",
      "textToken": "--text-label",
      "iconSize": "14"
    },
    "md": {
      "controlHeight": "--ctl-md",
      "paddingInline": [
        "--sp-2",
        "--sp-2"
      ],
      "gap": "--sp-2",
      "textToken": "--text-label",
      "iconSize": "16"
    },
    "lg": {
      "controlHeight": "--ctl-lg",
      "paddingInline": [
        "--sp-2",
        "--sp-2"
      ],
      "gap": "--sp-2",
      "textToken": "--text-label",
      "iconSize": "18"
    }
  },
  "states": [
    {
      "id": "default",
      "description": "通常状態。意味、label、valueを省略しない。",
      "requiredBehavior": [
        "通常状態。意味、label、valueを省略しない。"
      ]
    },
    {
      "id": "hover",
      "description": "Pointer hoverの補助変化。意味をhoverだけに依存させない。",
      "requiredBehavior": [
        "Pointer hoverの補助変化。意味をhoverだけに依存させない。"
      ]
    },
    {
      "id": "focus",
      "description": "focus-visibleで明確なringを表示する。",
      "requiredBehavior": [
        "focus-visibleで明確なringを表示する。"
      ]
    },
    {
      "id": "error",
      "description": "色だけでなくmessageとaria stateで問題を伝える。",
      "requiredBehavior": [
        "色だけでなくmessageとaria stateで問題を伝える。"
      ]
    },
    {
      "id": "disabled",
      "description": "操作不能である理由を周辺文脈から理解できるようにする。",
      "requiredBehavior": [
        "操作不能である理由を周辺文脈から理解できるようにする。"
      ]
    },
    {
      "id": "readonly",
      "description": "値を参照・選択できるが変更できない。",
      "requiredBehavior": [
        "値を参照・選択できるが変更できない。"
      ]
    }
  ],
  "props": [
    {
      "name": "size",
      "type": "\"sm\" | \"md\" | \"lg\"",
      "required": false,
      "default": "md",
      "description": "Density内の相対sizeを選ぶ。"
    },
    {
      "name": "value",
      "type": "unknown",
      "required": false,
      "default": null,
      "description": "Controlled value。"
    },
    {
      "name": "onChange",
      "type": "(value) => void",
      "required": false,
      "default": null,
      "description": "User操作で値が変わるときに通知する。"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "default": "false",
      "description": "操作不能state。"
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Label"
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Placeholder"
    },
    {
      "name": "helper",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Helper text"
    },
    {
      "name": "leading",
      "type": "boolean",
      "required": false,
      "default": "false",
      "description": "Leading icon"
    },
    {
      "name": "trailing",
      "type": "boolean",
      "required": false,
      "default": "false",
      "description": "Trailing affix"
    }
  ],
