  "accessibility": {
    "requirements": [
      "Keyboardとpointerで同じ機能を実行できる。",
      "Focus indicatorを常に視認でき、sticky layerで完全に隠さない。",
      "Targetは24px minimumを満たし、主要touch操作は原則44px以上にする。"
    ],
    "aria": [
      "Native semanticsを優先し、ARIAは不足する関係と状態だけを補う。"
    ],
    "focus": [
      "focus-visibleで--focus-ringを使う。",
      "Positive tabindexを使わず、DOMとvisualの順序を一致させる。"
    ]
  },
  "keyboardInteractions": [
    {
      "key": "Arrow Up / Down",
      "action": "Model optionを移動する。"
    },
    {
      "key": "Enter",
      "action": "Modelを選択する。"
    },
    {
      "key": "Escape",
      "action": "Menuを閉じる。"
    }
  ],
  "usagePatterns": [
    {
      "id": "recommended-1",
      "title": "Primary context",
      "description": "複数AI modelの特性を比較して実行contextを選ぶとき。",
      "recommended": [
        "モデル名は等幅フォントで表示する。"
      ],
      "avoid": [
        "modelが固定の体験では選択UIを表示しない。"
      ]
    }
  ],
  "responsiveBehavior": {
    "desktop": {
      "summary": "DesktopでのModel Selector。",
      "rules": [
        "Triggerへ位置付け、viewport端ではplacementを反転またはshiftする。",
        "Pointerとkeyboardの両方で同じ内容へ到達できる。"
      ],
      "avoid": [
        "Hoverだけで状態や操作を伝えない。"
      ]
    },
    "mobile": {
      "summary": "MobileでのModel Selector。",
      "rules": [
        "Hover起点を使わずtapまたはfocusで開き、狭い幅ではsheet presentationを選べる。",
        "Triggerとsurfaceを同時に画面外へ追い出さない。"
      ],
      "avoid": [
        "PC用とSP用に意味やAPIの異なるcomponentを複製しない。"
      ]
    },
    "touch": {
      "summary": "Touch入力でのModel Selector。",
      "rules": [
        "Pointer targetは24px minimumを満たし、touch中心の主要操作は原則44px以上にする。",
        "Hoverだけに情報や操作を依存させず、連打とdragには同等の非gesture操作を用意する。"
      ],
      "avoid": [
        "小さな隣接targetやgestureだけの操作を作らない。"
      ]
    }
  },
  "rules": [
    "NO_RAW_HEX_COLOR",
    "SPACING_FROM_TOKENS_ONLY",
    "RADIUS_FROM_TOKENS_ONLY",
    "CONTRAST_AA_MINIMUM",
    "FOCUS_VISIBLE_REQUIRED",
    "NO_POSITIVE_TABINDEX",
    "TARGET_SIZE_MINIMUM",
    "INTERACTIVE_NAME_REQUIRED"
  ],
  "qualityChecks": [
    "When to use / not useの境界が明確",
    "PC / SP / touchで同じsemantic contractを維持",
    "公開tokenだけを参照",
    "Keyboardとaccessible nameを検証",
    "Light / Dark × Standard / Highと3 densityで確認"
  ],
  "examples": [
    {
      "id": "default",
      "description": "Model Selectorの標準例。",
      "code": "<ModelSelector\n  models={models}\n  value=\"claude-sonnet-4-6\"\n  onChange={setModel}\n/>"
    }
  ],
  "openQuestions": [
    "React package実装時にDOM/ref/event APIと全visual slot bindingを確定し、coverage completeでstableへ移行する。"
  ]
}
