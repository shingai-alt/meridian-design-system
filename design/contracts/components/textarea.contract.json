{
  "$schema": "../../../schemas/component-contract.schema.json",
  "schemaVersion": "0.1.0",
  "id": "textarea",
  "name": "Textarea",
  "status": "draft",
  "category": "forms",
  "description": "複数行のテキスト入力。行数の目安を rows で示す。",
  "source": {
    "humanDoc": "components/textarea.md",
    "registry": "js/components-registry.js#textarea"
  },
  "intent": {
    "whenToUse": [
      "説明文・コメントなどの長文入力"
    ],
    "whenNotToUse": [
      "1 行で収まる入力 → Text Field"
    ],
    "principles": [
      1,
      2,
      3,
      5,
      6
    ]
  },
  "anatomy": [
    {
      "part": "root",
      "required": true,
      "description": "Control boundary and focus indicator."
    },
    {
      "part": "control",
      "required": true,
      "description": "Native input or textarea that owns the value."
    },
    {
      "part": "adornment",
      "required": false,
      "description": "Prefix, suffix, clear, attachment, or submit action."
    },
    {
      "part": "message",
      "required": false,
      "description": "Help, count, loading, or validation feedback."
    }
  ],
  "variants": {
    "default": {
      "intent": "標準文脈。",
      "tokenRefs": {},
      "states": {}
    }
  },
  "sizes": {},
  "states": [
    {
      "id": "default",
      "description": "通常状態。意味、label、valueを省略しない。",
      "requiredBehavior": [
        "通常状態。意味、label、valueを省略しない。"
      ]
    },
    {
      "id": "focus",
      "description": "focus-visibleで明確なringを表示する。",
      "requiredBehavior": [
        "focus-visibleで明確なringを表示する。"
      ]
    },
    {
      "id": "error",
      "description": "色だけでなくmessageとaria stateで問題を伝える。",
      "requiredBehavior": [
        "色だけでなくmessageとaria stateで問題を伝える。"
      ]
    },
    {
      "id": "disabled",
      "description": "操作不能である理由を周辺文脈から理解できるようにする。",
      "requiredBehavior": [
        "操作不能である理由を周辺文脈から理解できるようにする。"
      ]
    }
  ],
  "props": [
    {
      "name": "value",
      "type": "unknown",
      "required": false,
      "default": null,
      "description": "Controlled value。"
    },
    {
      "name": "onChange",
      "type": "(value) => void",
      "required": false,
      "default": null,
      "description": "User操作で値が変わるときに通知する。"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "default": "false",
      "description": "操作不能state。"
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Label"
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Placeholder"
    }
