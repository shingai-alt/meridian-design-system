    },
    {
      "name": "value",
      "type": "unknown",
      "required": false,
      "default": null,
      "description": "Controlled value。"
    },
    {
      "name": "onChange",
      "type": "(value) => void",
      "required": false,
      "default": null,
      "description": "User操作で値が変わるときに通知する。"
