  "selectionRules": {
    "useWhen": ["App全体の現在地とpage横断actionを、shell上端の一貫した位置へ置く。"],
    "avoidWhen": ["Page固有title/action、primary destination list、または単独toolbarを表す。"],
    "alternatives": ["Page Header", "Sidebar", "Toolbar", "Breadcrumb"]
  },
  "negativeExamples": [
    { "pattern": "Top Bar rootへrole=navigationを付ける。", "reason": "Breadcrumbなど子navigation landmarkとTop Bar containerの意味が重複するため。", "ruleIds": ["INTERACTIVE_NAME_REQUIRED"] },
    { "pattern": "Actions containerへrole=toolbarを付けて通常Tab順のままにする。", "reason": "Toolbar roleが要求するroving focus modelを実装していないため。", "ruleIds": ["NO_POSITIVE_TABINDEX"] }
  ],
  "requiredScenarios": ["default", "sticky", "default-variant", "with-leading", "with-breadcrumb", "global-actions", "long-location", "narrow-viewport"],
  "id": "top-bar",
  "name": "Top Bar",
  "status": "draft",
  "category": "navigation",
  "description": "App shell上端で現在地とpage横断actionを構成するheader。",
  "source": { "humanDoc": "components/top-bar.md", "registry": "js/components-registry.js#top-bar" },
  "intent": {
    "whenToUse": ["Breadcrumbまたは現在地とglobal search、notifications、account controlsを一貫して配置する。", "Responsive navigation triggerをshell上端へ置く。"],
    "whenNotToUse": ["Page固有titleとactionはPage Headerを使う。", "Destination listはSidebarを使う。", "編集command群はToolbarを使う。", "Top Bar自身をnavigation landmarkにしない。"],
    "principles": [1, 2, 3, 5, 6]
  },
  "anatomy": [
    { "part": "root", "required": true, "description": "Introductory/navigation aidsをまとめるnative header。" },
    { "part": "leading", "required": false, "description": "Responsive Sidebar triggerまたはproduct context。" },
    { "part": "location", "required": true, "description": "Breadcrumbまたは現在地を表す可視text。" },
    { "part": "actions", "required": false, "description": "Search、notification、accountなどpage横断control。" }
  ],
  "variants": {
    "default": {
      "intent": "現在地とglobal actionsをinlineに構成する唯一のvariant。",
      "tokenRefs": { "background": "--surface", "border": "--border", "height": "--topbar-h" },
      "states": { "sticky": { "background": "--surface" } }
    }
  },
  "sizes": {},
  "states": [
    { "id": "default", "description": "Document flow内のshell header。", "requiredBehavior": ["Locationを常に識別可能", "Child controlsのnative Tab順を維持"] },
    { "id": "sticky", "description": "Viewport上端へ固定されるheader。", "requiredBehavior": ["data-sticky=true", "後続focus targetを完全に隠さないscroll offset", "Main contentのreading orderを変えない"] }
  ],
  "props": [
    { "name": "location", "type": "ReactNode", "required": true, "default": null, "description": "Breadcrumbまたは現在地label。" },
    { "name": "leading", "type": "ReactNode", "required": false, "default": null, "description": "Sidebar disclosureなどshell-level leading control。" },
    { "name": "actions", "type": "ReactNode", "required": false, "default": null, "description": "Global search、notification、account controls。" },
    { "name": "sticky", "type": "boolean", "required": false, "default": "false", "description": "trueでviewport上端へ固定しdata-stickyを設定する。" },
    { "name": "ref", "type": "ForwardedRef<HTMLElement>", "required": false, "default": null, "description": "Native header elementへforwardするref。" }
  ],
  "tokenRefs": {
    "semanticColor": ["--surface", "--border", "--fg"],
    "layout": ["--topbar-h"],
    "spacing": ["--sp-2", "--sp-4"]
  },
  "tokenBindings": {
    "coverage": "complete",
    "bindings": [
      { "slot": "root.background", "source": "--surface", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Sticky時もcontentを透過させず判読性を保つshell surface。" },
      { "slot": "root.border-block-end", "source": "--border", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Main contentとの境界を示す。" },
      { "slot": "root.foreground", "source": "--fg", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Current locationとglobal controlsの基本foreground。" },
      { "slot": "root.block-size", "source": "--topbar-h", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Shellとscroll offsetが共有するTop Bar高さ。" },
      { "slot": "root.padding-inline", "source": "--sp-4", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Viewport edgeとleading/actionsを分離する。" },
      { "slot": "root.gap", "source": "--sp-2", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Leading、location、actions間のrhythm。" },
      { "slot": "actions.gap", "source": "--sp-2", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Global controlsのtargetを分離する。" },
      { "slot": "root.shadow", "source": "none", "scope": "literal", "componentToken": null, "aliases": null, "trigger": null, "reason": "Top Barはborderでshell hierarchyを示しelevationを持たない。" }
    ],
    "unboundSlots": []
  },
  "accessibility": {
    "requirements": ["Rootはnative headerを使う。", "Locationは常に可視でpage contextを説明する。", "各actionは自身のcomponent contractでaccessible nameとtargetを持つ。", "Sticky時も後続のfocused elementを完全に隠さない。"],
    "aria": ["Headerへrole=bannerを明示しない。Landmark mappingはdocument contextに従う。", "Top Barへrole=navigationを付けない。Breadcrumbが自身のnav landmarkを所有する。", "Actionsへtoolbar roleを付けずnative Tab順を維持する。"],
    "focus": ["DOM順をleading、location内links、actionsと一致させる。", "Sticky高さをscroll-padding/scroll-marginへ反映する。", "Narrow viewportでlabelを省略するactionはprogrammatic labelとTooltipを維持し、hiddenにするactionは同じ機能へ到達できるMenu等へ移す。"]
  },
  "keyboardInteractions": [
    { "key": "Tab / Shift+Tab", "action": "Leading、location内links、actionsをnative document順で移動する。" },
    { "key": "Enter / Space", "action": "Focused child component固有のnative activationを実行する。Top Bar独自keyboard modelは追加しない。" }
  ],
  "usagePatterns": [
    { "id": "shell-context", "title": "Shell context", "description": "現在地とglobal actionsを一貫して配置する。", "recommended": ["Locationをrequiredにする", "Global actionsだけをactionsへ置く"], "avoid": ["Page固有primary action", "Top Bar rootをnavにする"] },
    { "id": "responsive-priority", "title": "Responsive priority", "description": "Narrow viewportでもleadingとlocationを残す。", "recommended": ["Secondary global actionsをTooltip付きIcon ButtonまたはMenu/Popoverへ再構成", "同じ機能とaccessible nameを維持"], "avoid": ["CSSで唯一のactionを到達不能にする", "Locationをiconだけにする"] }
  ],
  "responsiveBehavior": {
    "desktop": { "summary": "Leading、full location、global actionsを1行に配置する。", "rules": ["Heightは--topbar-h", "Locationはavailable spaceを受け取る", "Actionsは末尾にまとまる"], "avoid": ["Page Header actionの重複", "Nested toolbar role"] },
    "mobile": { "summary": "Sidebar triggerとcurrent locationを優先し、secondary actionsを再構成する。", "rules": ["Leading triggerとlocationを保持", "Global actionはTooltip付きIcon ButtonまたはMenu/Popover内でも同じcomponent contractを維持", "Document横overflowを起こさない"], "avoid": ["唯一のsearch/account経路をdisplay:none", "Mobile専用Top Bar API"] },
    "touch": { "summary": "Global controlsへ十分なtargetと間隔を提供する。", "rules": ["最低24px target", "Primary touch controlsは44px推奨", "Hover非依存"], "avoid": ["密集したicon controls", "Tooltipだけのaccessible name"] }
  },
  "rules": ["INTERACTIVE_NAME_REQUIRED", "FOCUS_VISIBLE_REQUIRED", "TARGET_SIZE_MINIMUM", "NO_POSITIVE_TABINDEX", "NO_RAW_HEX_COLOR", "SPACING_FROM_TOKENS_ONLY"],
  "qualityChecks": ["Rootがheaderでnav/toolbar roleを持たない。", "Location slotが存在する。", "Breadcrumbは独立したnamed navを維持する。", "Sticky時のscroll offsetが--topbar-hと同期する。", "Narrow viewportでdocument横overflowがない。", "Hidden actionに代替経路がある。"],
  "examples": [
    { "id": "default", "description": "Breadcrumbとglobal actionsを持つshell header。", "code": "<TopBar leading={<SidebarTrigger />} location={<Breadcrumb items={crumbs} />} actions={<><SearchField /><NotificationButton /><UserMenu /></>} />" }
  ],
  "openQuestions": []
}
