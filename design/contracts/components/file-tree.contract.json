  "accessibility": {
    "requirements": [
      "Keyboardとpointerで同じ機能を実行できる。",
      "Focus indicatorを常に視認でき、sticky layerで完全に隠さない。",
      "Targetは24px minimumを満たし、主要touch操作は原則44px以上にする。"
    ],
    "aria": [
      "Interactive hierarchyはtree / treeitem semanticsとexpanded stateを同期する。"
    ],
    "focus": [
      "focus-visibleで--focus-ringを使う。",
      "Positive tabindexを使わず、DOMとvisualの順序を一致させる。"
    ]
  },
  "keyboardInteractions": [
    {
      "key": "Arrow Up / Down",
      "action": "Visible nodeを移動する。"
    },
    {
      "key": "Arrow Right / Left",
      "action": "Nodeを展開 / 折りたたむ。"
    },
    {
      "key": "Enter",
      "action": "Focused fileを開く。"
    }
  ],
  "usagePatterns": [
    {
      "id": "recommended-1",
      "title": "Primary context",
      "description": "階層fileを展開し、選択や変更状態を確認するとき。",
      "recommended": [
        "変更のあるファイルにはドットを付ける。"
      ],
      "avoid": [
        "flatな少数fileにはListを使う。"
      ]
    }
  ],
  "responsiveBehavior": {
    "desktop": {
      "summary": "DesktopでのFile Tree。",
      "rules": [
        "CompactまたはDefault densityで走査性を優先し、metadataとactionの列を安定させる。",
        "Hover actionはfocusでも表示する。"
      ],
      "avoid": [
        "Hoverだけで状態や操作を伝えない。"
      ]
    },
    "mobile": {
      "summary": "MobileでのFile Tree。",
      "rules": [
        "主情報を先にしてmetadataを折り返し、非表示情報にはdetail viewから到達できるようにする。",
        "行全体clickだけに依存せず明示的なtargetを残す。"
      ],
      "avoid": [
        "PC用とSP用に意味やAPIの異なるcomponentを複製しない。"
      ]
    },
    "touch": {
      "summary": "Touch入力でのFile Tree。",
      "rules": [
        "Pointer targetは24px minimumを満たし、touch中心の主要操作は原則44px以上にする。",
        "Hoverだけに情報や操作を依存させず、連打とdragには同等の非gesture操作を用意する。"
      ],
      "avoid": [
        "小さな隣接targetやgestureだけの操作を作らない。"
      ]
    }
  },
  "rules": [
    "NO_RAW_HEX_COLOR",
    "SPACING_FROM_TOKENS_ONLY",
    "RADIUS_FROM_TOKENS_ONLY",
    "CONTRAST_AA_MINIMUM",
    "FOCUS_VISIBLE_REQUIRED",
    "NO_POSITIVE_TABINDEX",
    "TARGET_SIZE_MINIMUM",
    "INTERACTIVE_NAME_REQUIRED"
  ],
  "qualityChecks": [
    "When to use / not useの境界が明確",
    "PC / SP / touchで同じsemantic contractを維持",
    "公開tokenだけを参照",
    "Keyboardとaccessible nameを検証",
    "Light / Dark × Standard / Highと3 densityで確認"
  ],
  "examples": [
    {
      "id": "default",
      "description": "File Treeの標準例。",
      "code": "<FileTree\n  data={tree}\n  activePath=\"src/components/data-table.tsx\"\n  modified={changedFiles}\n  searchable\n/>"
    }
  ],
  "openQuestions": [
    "React package実装時にDOM/ref/event APIと全visual slot bindingを確定し、coverage completeでstableへ移行する。"
  ]
}
