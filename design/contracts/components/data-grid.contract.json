  "accessibility": {
    "requirements": [
      "Keyboardとpointerで同じ機能を実行できる。",
      "Focus indicatorを常に視認でき、sticky layerで完全に隠さない。",
      "Targetは24px minimumを満たし、主要touch操作は原則44px以上にする。"
    ],
    "aria": [
      "Interactive cell navigationがある場合だけgrid semanticsを使う。"
    ],
    "focus": [
      "focus-visibleで--focus-ringを使う。",
      "Positive tabindexを使わず、DOMとvisualの順序を一致させる。"
    ]
  },
  "keyboardInteractions": [
    {
      "key": "Arrow keys",
      "action": "Grid cell間を移動する。"
    },
    {
      "key": "Home / End",
      "action": "行またはgrid端へ移動する。"
    },
    {
      "key": "Enter / F2",
      "action": "編集可能cellの編集を開始する。"
    }
  ],
  "usagePatterns": [
    {
      "id": "recommended-1",
      "title": "Primary context",
      "description": "数千行規模のデータ操作",
      "recommended": [
        "列の表示/非表示・並び順はユーザーごとに保存する。"
      ],
      "avoid": [
        "単純な一覧 → Table(実装コストが 1/10)"
      ]
    },
    {
      "id": "recommended-2",
      "title": "Secondary context",
      "description": "インライン編集",
      "recommended": [
        "ソート状態は URL クエリに同期し、共有可能にする。"
      ],
      "avoid": [
        "単純な一覧 → Table(実装コストが 1/10)"
      ]
    }
  ],
  "responsiveBehavior": {
    "desktop": {
      "summary": "DesktopでのData Grid。",
      "rules": [
        "列・項目の比較可能性を保ち、必要な幅を確保する。",
        "Keyboard focusと選択状態をscroll位置から失わない。"
      ],
      "avoid": [
        "Hoverだけで状態や操作を伝えない。"
      ]
    },
    "mobile": {
      "summary": "MobileでのData Grid。",
      "rules": [
        "意味のある列や項目を潰さず、横scroll、優先列、detail viewのいずれかを明示的に選ぶ。",
        "Scroll領域の外にも現在位置や操作の手掛かりを残す。"
      ],
      "avoid": [
        "PC用とSP用に意味やAPIの異なるcomponentを複製しない。"
      ]
    },
    "touch": {
      "summary": "Touch入力でのData Grid。",
      "rules": [
        "Pointer targetは24px minimumを満たし、touch中心の主要操作は原則44px以上にする。",
        "Hoverだけに情報や操作を依存させず、連打とdragには同等の非gesture操作を用意する。"
      ],
      "avoid": [
        "小さな隣接targetやgestureだけの操作を作らない。"
      ]
    }
  },
  "rules": [
    "NO_RAW_HEX_COLOR",
    "SPACING_FROM_TOKENS_ONLY",
    "RADIUS_FROM_TOKENS_ONLY",
    "CONTRAST_AA_MINIMUM",
    "FOCUS_VISIBLE_REQUIRED",
    "NO_POSITIVE_TABINDEX",
    "TARGET_SIZE_MINIMUM",
    "INTERACTIVE_NAME_REQUIRED"
  ],
  "qualityChecks": [
    "When to use / not useの境界が明確",
    "PC / SP / touchで同じsemantic contractを維持",
    "公開tokenだけを参照",
    "Keyboardとaccessible nameを検証",
    "Light / Dark × Standard / Highと3 densityで確認"
  ],
  "examples": [
    {
      "id": "default",
      "description": "Data Gridの標準例。",
      "code": "<DataGrid\n  columns={columns}\n  rows={rows}\n  sortModel={sort}\n  onSortChange={setSort}\n  virtualized\n/>"
    }
  ],
  "openQuestions": [
    "React package実装時にDOM/ref/event APIと全visual slot bindingを確定し、coverage completeでstableへ移行する。"
  ]
}
