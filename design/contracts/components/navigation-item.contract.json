    { "part": "root", "required": true, "description": "hrefを持つnative anchor。Parentのnav/listは所有しない。" },
    { "part": "icon", "required": false, "description": "Labelを補強するdecorative icon。aria-hidden。" },
    { "part": "label", "required": true, "description": "Destinationを具体的に表す可視text。" },
    { "part": "badge", "required": false, "description": "未読や件数の短いmetadata。Labelの後ろに配置する。" },
    { "part": "current-indicator", "required": false, "description": "aria-currentと同期する面・weightの非色依存cue。" }
  ],
  "variants": {
    "default": {
      "intent": "Sidebarと永続navigationで使う唯一のvisual model。",
      "tokenRefs": { "foreground": "--fg-muted", "currentForeground": "--primary", "currentBackground": "--sidebar-item-active-bg" },
      "states": { "hover": { "background": "--surface-muted", "foreground": "--fg" }, "current": { "background": "--sidebar-item-active-bg", "foreground": "--primary" } }
