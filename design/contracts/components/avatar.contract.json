  "accessibility": {
    "requirements": [
      "表示専用rootを不要にtab順へ追加しない。",
      "状態は色だけで表さずtext、icon、shapeを併用する。"
    ],
    "aria": [
      "Native semanticsを優先し、ARIAは不足する関係と状態だけを補う。"
    ],
    "focus": [
      "Nested controlがある場合だけ、そのcontrolがfocusを受け取る。"
    ]
  },
  "keyboardInteractions": [],
  "usagePatterns": [
    {
      "id": "recommended-1",
      "title": "Primary context",
      "description": "担当者・作成者の表示",
      "recommended": [
        "画像が無い場合はイニシャルにフォールバックする。"
      ],
      "avoid": [
        "装飾目的のアイコン"
      ]
    },
    {
      "id": "recommended-2",
      "title": "Secondary context",
      "description": "メンバーリスト",
      "recommended": [
        "重ね表示(AvatarStack)は 3〜4 個で省略し「+N」を付ける。"
      ],
      "avoid": [
        "装飾目的のアイコン"
      ]
    }
  ],
  "responsiveBehavior": {
    "desktop": {
      "summary": "DesktopでのAvatar。",
      "rules": [
        "Contentと周辺layoutに応じたintrinsic sizeを使う。",
        "Viewportだけを理由にdensityを変更しない。"
      ],
      "avoid": [
        "Hoverだけで状態や操作を伝えない。"
      ]
    },
    "mobile": {
      "summary": "MobileでのAvatar。",
      "rules": [
        "意味とDOM順を変えず、wrapとavailable widthで適応する。",
        "省略した情報へ別経路から到達できるようにする。"
      ],
      "avoid": [
        "PC用とSP用に意味やAPIの異なるcomponentを複製しない。"
      ]
    },
    "touch": {
      "summary": "Touch入力でのAvatar。",
      "rules": [
        "表示専用rootをtab順へ追加しない。",
        "内包する操作がある場合だけ、その操作targetを24px minimum、主要touch操作を原則44px以上にする。"
      ],
      "avoid": [
        "小さな隣接targetやgestureだけの操作を作らない。"
      ]
    }
  },
  "rules": [
    "NO_RAW_HEX_COLOR",
    "SPACING_FROM_TOKENS_ONLY",
    "RADIUS_FROM_TOKENS_ONLY",
    "CONTRAST_AA_MINIMUM"
  ],
  "qualityChecks": [
    "When to use / not useの境界が明確",
    "PC / SP / touchで同じsemantic contractを維持",
    "公開tokenだけを参照",
    "Keyboardとaccessible nameを検証",
    "Light / Dark × Standard / Highと3 densityで確認"
  ],
  "examples": [
    {
      "id": "default",
      "description": "Avatarの標準例。",
      "code": "<Avatar name=\"新谷\" size=\"md\" />\n<AvatarStack max={3} users={members} />"
    }
  ],
  "openQuestions": [
    "React package実装時にDOM/ref/event APIと全visual slot bindingを確定し、coverage completeでstableへ移行する。"
  ]
}
