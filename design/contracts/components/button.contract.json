      "avoid": ["行内に danger を直接置く", "Button に合わせて行高を広げすぎる"]
    },
    {
      "id": "mobile-cta",
      "title": "Mobile CTA",
      "description": "モバイル幅で主要操作を明確に示す領域。",
      "recommended": ["主要 CTA は fullWidth を使ってよい", "ラベルを短く具体的にする"],
      "avoid": ["複数 Button を横並びで詰め込む", "bottom fixed action とページ内 CTA を重複させる"]
    }
  ],
  "responsiveBehavior": {
    "desktop": {
      "summary": "PC では inline 配置と md サイズを標準にし、文脈ごとの優先度を variant で表す。",
      "rules": [
        "標準サイズは md",
        "Form footer / Dialog footer / Toolbar では inline 配置を基本にする",
        "Table row action は xs または sm を使う",
        "hover / active の視覚変化を持ってよいが hover だけに意味を依存しない",
        "primary は 1 つの意思決定文脈に原則 1 つ"
      ],
      "avoid": [
        "primary を複数並べる",
        "Button に合わせて table row の高さを広げる",
        "desktop 専用 Button component を作る"
      ]
    },
    "mobile": {
      "summary": "SP では同じ Button を使い、fullWidth、lg/xl、縦積みなどの layout pattern で最適化する。",
      "rules": [
        "主要 CTA は fullWidth を許可する",
        "主要 CTA は lg または xl を使える",
        "複数 Button は横並びを避け、縦積みまたは primary + text link に分ける",
        "danger action は確認 UI の中で使う",
        "bottom fixed action とページ内 CTA を重複させない"
      ],
      "avoid": [
        "mobile 専用 Button component を作る",
        "複数 Button を横並びにしてラベルを詰め込む",
        "danger を画面下部の大きな常時 CTA として露出する"
      ]
    },
    "touch": {
      "summary": "Touch 環境では押しやすさ、hover 非依存、二重実行防止を優先する。",
      "rules": [
        "操作targetは24px minimum、touch中心の主要操作は原則44px以上にする",
        "Comfortable density では主要操作の押しやすさを優先する",
        "hover に意味を依存しない",
        "icon-only action はIcon Buttonへ分離し、十分なtouch targetを確保する",
        "loading 中は二重実行を防ぐ"
      ],
      "avoid": [
        "hover でしか分からない状態表現",
        "小さすぎるIcon Button",
        "loading 中に連打できる状態"
      ]
    }
  },
