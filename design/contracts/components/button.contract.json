{
  "$schema": "../../../schemas/component-contract.schema.json",
  "schemaVersion": "0.1.0",
  "contractVersion": "0.1.0",
  "runtime": {
    "compatibility": ">=0.1.0 <1.0.0",
    "rootElements": ["button"],
    "slots": ["label", "leading-icon", "trailing-icon", "spinner"],
    "attributes": ["type", "disabled", "aria-disabled", "aria-label", "aria-busy"],
    "stateModel": ["data-meridian-variant", "data-meridian-state"],
    "events": ["click"],
    "relations": ["accessible-name"],
    "provenance": ["component", "instance", "variant", "state", "contract-version", "runtime-version", "decision"]
  },
  "selectionRules": { "useWhen": ["状態を変更する明確なactionを実行する。"], "avoidWhen": ["ページ遷移だけならLinkを使う。"], "alternatives": ["link", "icon-button"] },
  "negativeExamples": [{ "pattern": "未登録variantや独自classでButtonを強調する。", "reason": "action hierarchyとToken bindingを迂回するため。", "ruleIds": ["NO_RAW_HEX_COLOR"] }],
  "requiredScenarios": ["default", "disabled", "loading", "focus", "primary", "secondary", "ghost"],
  "id": "button",
  "name": "Button",
  "status": "draft",
  "category": "core",
  "description": "アクションを実行するための基本コントロール。優先度、危険度、文脈に応じて variant を選ぶ。",
  "source": {
    "humanDoc": "components/button.md",
    "registry": "js/components-registry.js#button"
  },
  "intent": {
    "whenToUse": [
      "フォームを送信する。",
      "設定変更を保存する。",
      "新しいリソースを作成する。",
      "ダイアログ内で操作を確定またはキャンセルする。",
      "テーブル行やツールバーで補助操作を実行する。",
      "削除、権限変更、取り消し不能な操作を明示する。"
    ],
    "whenNotToUse": [
      "ページ遷移や外部参照だけが目的の場合は Link を使う。",
      "2 から 4 個の表示モードを切り替える場合は Segmented Control を使う。",
      "複数の排他選択肢を提示する場合は Radio Group を使う。",
      "即時反映する設定の ON/OFF は Switch を使う。",
      "アイコンだけで意味が明確な補助操作は Icon Button を使う。",
      "ただ目立たせたいだけのテキストやラベルには使わない。"
    ],
    "principles": [1, 2, 3, 5, 6]
  },
  "anatomy": [
    {
      "part": "root",
      "required": true,
      "description": "button 要素。variant、size、state に応じた token だけで見た目を構成する。"
    },
    {
      "part": "label",
      "required": true,
      "description": "操作結果を予測できる短い文言。iconOnly の場合は視覚表示ではなく accessible name として必須。"
    },
    {
      "part": "leadingIcon",
      "required": false,
      "description": "操作の意味を補強するアイコン。装飾だけのアイコンは aria-hidden にする。"
    },
    {
      "part": "trailingIcon",
      "required": false,
      "description": "遷移、展開、外部リンクなど、操作後の方向を補足するアイコン。"
    },
    {
      "part": "spinner",
      "required": false,
      "description": "loading 中の進行表示。ラベルを消さず、aria-busy と disabled behavior を併用する。"
    }
  ],
  "variants": {
    "primary": {
      "intent": "画面内の最重要アクション。原則として 1 画面または 1 文脈に 1 つ。",
      "tokenRefs": {
        "background": "--primary",
        "foreground": "--primary-fg",
        "border": "--primary"
      },
      "states": {
        "hover": { "background": "--primary-hover" },
        "active": { "background": "--primary-active" },
        "disabled": { "background": "--disabled", "foreground": "--fg-disabled", "border": "--disabled" }
      }
    },
    "secondary": {
      "intent": "主要アクションに次ぐ補助アクション。キャンセルより強く、primary より弱い。",
      "tokenRefs": {
        "background": "--control-bg",
        "foreground": "--fg",
        "border": "--control-border"
      },
      "states": {
        "hover": { "background": "--control-bg-hover", "border": "--control-border-hover" },
        "active": { "background": "--control-bg-active", "border": "--control-border-hover" },
        "disabled": { "background": "--control-bg", "foreground": "--fg-disabled", "border": "--control-border" }
      }
    },
    "tertiary": {
      "intent": "低優先だが見つけやすくしたいアクション。選択済みや軽い強調にも使う。",
      "tokenRefs": {
        "background": "--primary-subtle",
        "foreground": "--primary",
        "border": "--primary-subtle"
      },
      "states": {
        "hover": { "background": "--primary-muted" },
        "active": { "background": "--primary-muted" },
        "disabled": { "background": "--surface-muted", "foreground": "--fg-disabled", "border": "--surface-muted" }
      }
    },
    "ghost": {
      "intent": "ツールバー、行内、ダイアログのキャンセルなど、面を増やしたくない補助操作。",
      "tokenRefs": {
        "background": "transparent",
        "foreground": "--fg",
        "border": "transparent"
      },
      "states": {
        "hover": { "background": "--surface-muted" },
        "active": { "background": "--surface-muted" },
        "disabled": { "foreground": "--fg-disabled" }
      }
    },
    "outline": {
      "intent": "並列に近い補助アクション。面ではなく境界線で affordance を示す。",
      "tokenRefs": {
        "background": "transparent",
        "foreground": "--fg",
        "border": "--border"
      },
      "states": {
        "hover": { "background": "--surface-muted", "border": "--border-strong" },
        "active": { "background": "--surface-muted", "border": "--border-strong" },
        "disabled": { "foreground": "--fg-disabled", "border": "--border-muted" }
      }
    },
    "danger": {
      "intent": "削除、取り消し不能、権限剥奪など破壊的な最終操作。確認 UI と併用する。",
      "tokenRefs": {
        "background": "--danger",
        "foreground": "--danger-on-solid",
        "border": "--danger"
      },
      "states": {
        "hover": { "background": "--danger" },
        "active": { "background": "--danger" },
        "disabled": { "background": "--disabled", "foreground": "--fg-disabled", "border": "--disabled" }
      }
    },
    "success": {
      "intent": "完了、承認、復旧など肯定的な確定操作。primary の代替ではなく状態文脈に限定する。",
      "tokenRefs": {
        "background": "--success",
        "foreground": "--success-on-solid",
        "border": "--success"
      },
      "states": {
        "hover": { "background": "--success" },
        "active": { "background": "--success" },
        "disabled": { "background": "--disabled", "foreground": "--fg-disabled", "border": "--disabled" }
      }
    },
    "link": {
      "intent": "軽い参照や補助導線。データ変更を伴う操作には使わない。",
      "tokenRefs": {
        "background": "transparent",
        "foreground": "--primary",
        "border": "transparent"
      },
      "states": {
        "hover": { "foreground": "--primary-hover" },
        "active": { "foreground": "--primary-active" },
        "disabled": { "foreground": "--fg-disabled" }
      }
    }
  },
  "sizes": {
    "xs": {
      "controlHeight": "--ctl-xs",
      "paddingInline": ["--sp-2", "--sp-2"],
      "gap": "--sp-1",
      "textToken": "--text-micro",
      "iconSize": "12"
    },
    "sm": {
      "controlHeight": "--ctl-sm",
      "paddingInline": ["--sp-25", "--sp-25"],
      "gap": "--sp-15",
      "textToken": "--text-small",
      "iconSize": "14"
    },
    "md": {
      "controlHeight": "--ctl-md",
      "paddingInline": ["--sp-3", "--sp-3"],
      "gap": "--sp-2",
      "textToken": "--text-label",
      "iconSize": "16"
    },
    "lg": {
      "controlHeight": "--ctl-lg",
      "paddingInline": ["--sp-4", "--sp-4"],
      "gap": "--sp-2",
      "textToken": "--text-label",
      "iconSize": "18"
    },
    "xl": {
      "controlHeight": "--ctl-xl",
      "paddingInline": ["--sp-5", "--sp-5"],
      "gap": "--sp-25",
      "textToken": "--text-body",
      "iconSize": "20"
    }
  },
  "states": [
    {
      "id": "default",
      "description": "操作可能な通常状態。",
      "requiredBehavior": ["button 要素としてフォーカス可能", "variant と size の既定 token を使う"]
    },
    {
      "id": "hover",
      "description": "ポインタが乗った状態。",
      "requiredBehavior": ["色または面の変化は token で表す", "hover だけに意味を依存しない"]
    },
    {
      "id": "active",
      "description": "押下中の状態。",
      "requiredBehavior": ["短い motion token で状態変化を伝える", "レイアウト寸法を変えない"]
    },
    {
      "id": "focus",
      "description": "キーボードフォーカスがある状態。",
      "requiredBehavior": ["focus-visible で --focus-ring を表示", "outline を消す場合は必ず代替リングを持つ"]
    },
    {
      "id": "disabled",
      "description": "操作不可の状態。",
      "requiredBehavior": ["native disabled または aria-disabled を目的に応じて選ぶ", "無効理由が必要な場合は aria-disabled と説明を併用"]
    },
    {
      "id": "loading",
      "description": "実行中の状態。",
      "requiredBehavior": ["aria-busy=\"true\" を設定", "二重送信を防ぐ", "ラベルまたは accessible name を維持"]
    }
  ],
  "props": [
    {
      "name": "variant",
      "type": "\"primary\" | \"secondary\" | \"tertiary\" | \"ghost\" | \"outline\" | \"danger\" | \"success\" | \"link\"",
      "required": false,
      "default": "primary",
      "description": "視覚的な優先度と文脈。"
    },
    {
      "name": "size",
      "type": "\"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\"",
      "required": false,
      "default": "md",
      "description": "密度 token に連動する高さと余白。"
    },
    {
      "name": "loading",
      "type": "boolean",
      "required": false,
      "default": "false",
      "description": "実行中表示。aria-busy と二重送信防止を伴う。"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "default": "false",
      "description": "操作不可。フォーム送信対象から外す場合に使う。"
    },
    {
      "name": "aria-label",
      "type": "string",
      "required": false,
      "default": null,
      "description": "iconOnly または視覚ラベルがない場合に必須。"
    },
    {
      "name": "fullWidth",
      "type": "boolean",
      "required": false,
      "default": "false",
      "description": "親コンテナ幅いっぱいに広げる。モバイルの主要アクションで使う。"
    }
  ],
  "tokenRefs": {
    "componentColor": [
      "--button-primary-bg",
      "--button-primary-bg-hover",
      "--button-primary-bg-active",
      "--button-primary-fg"
    ],
    "semanticColor": [
      "--primary",
      "--primary-hover",
      "--primary-active",
      "--primary-subtle",
      "--primary-muted",
      "--primary-fg",
      "--control-bg",
      "--control-bg-hover",
      "--control-bg-active",
      "--control-border",
      "--control-border-hover",
      "--surface",
      "--surface-muted",
      "--fg",
      "--fg-disabled",
      "--border",
      "--border-muted",
      "--border-strong",
      "--danger",
      "--danger-on-solid",
      "--success",
      "--success-on-solid",
      "--disabled",
      "--focus-ring"
    ],
    "density": ["--ctl-xs", "--ctl-sm", "--ctl-md", "--ctl-lg", "--ctl-xl", "--text-micro", "--text-small", "--text-label", "--text-body"],
    "spacing": ["--sp-1", "--sp-15", "--sp-2", "--sp-25", "--sp-3", "--sp-4", "--sp-5"],
    "radius": ["--radius-sm"],
    "motion": ["--dur-fast", "--dur-normal"]
  },
  "tokenBindings": {
    "coverage": "partial",
