{
  "$schema": "../../../schemas/component-contract.schema.json",
  "schemaVersion": "0.1.0",
  "contractVersion": "0.2.0",
  "runtime": {
    "compatibility": ">=0.1.0 <1.0.0",
    "rootElements": ["button"],
    "slots": ["label", "leading-icon", "trailing-icon", "spinner"],
    "attributes": ["type", "disabled", "name", "value", "form", "formAction", "formEncType", "formMethod", "formNoValidate", "formTarget", "aria-*", "data-*"],
    "stateModel": ["data-meridian-variant", "data-meridian-state"],
    "events": ["click", "keydown", "focus", "blur"],
    "relations": ["accessible-name", "description", "native-button-props-passthrough"],
    "provenance": ["component", "instance", "variant", "state", "contract-version", "runtime-version", "decision"]
  },
  "selectionRules": {
    "useWhen": ["状態を変更する明確なactionを実行する。", "フォームを送信、保存、作成、削除、キャンセルする。"],
    "avoidWhen": ["ページ遷移だけならLinkを使う。", "アイコンだけの操作ならIcon Buttonを使う。", "選択状態の切り替えには専用のselection controlを使う。"],
    "alternatives": ["link", "icon-button", "switch", "segmented-control"]
  },
  "negativeExamples": [
    { "pattern": "未登録variantや独自classでButtonを強調する。", "reason": "action hierarchyとToken bindingを迂回するため。", "ruleIds": ["NO_RAW_HEX_COLOR"] },
    { "pattern": "可視ラベルなしのButtonを作る。", "reason": "Icon-only actionの責務をIcon Buttonから奪い、音声入力と認知上の手掛かりを弱めるため。", "ruleIds": ["FOCUS_VISIBLE_REQUIRED"] }
  ],
  "requiredScenarios": ["default", "disabled", "loading", "focus", "primary", "secondary", "tertiary", "ghost", "danger", "with-leading-icon", "with-trailing-icon", "full-width", "form-submit"],
  "id": "button",
  "name": "Button",
  "status": "draft",
  "category": "core",
  "description": "アクションを実行するための基本コントロール。優先度、危険度、文脈に応じて variant を選ぶ。",
  "source": {
    "humanDoc": "components/button.md",
    "registry": "js/components-registry.js#button"
  },
  "intent": {
    "whenToUse": [
      "フォームを送信する。",
      "設定変更を保存する。",
      "新しいリソースを作成する。",
      "ダイアログ内で操作を確定またはキャンセルする。",
      "テーブル行やツールバーで補助操作を実行する。",
      "削除、権限変更、取り消し不能な操作を明示する。"
    ],
    "whenNotToUse": [
      "ページ遷移や外部参照だけが目的の場合は Link を使う。",
      "2 から 4 個の表示モードを切り替える場合は Segmented Control を使う。",
      "複数の排他選択肢を提示する場合は Radio Group を使う。",
      "即時反映する設定の ON/OFF は Switch を使う。",
      "アイコンだけで意味が明確な補助操作は Icon Button を使う。",
      "ただ目立たせたいだけのテキストやラベルには使わない。"
    ],
    "principles": [1, 2, 3, 5, 6]
  },
  "anatomy": [
    {
      "part": "root",
      "required": true,
      "description": "button 要素。variant、size、state に応じた token だけで見た目を構成する。"
    },
    {
      "part": "label",
      "required": true,
      "description": "操作結果を予測できる可視ラベル。Buttonでは必須で、アイコンだけの操作はIcon Buttonへ分離する。"
    },
    {
      "part": "leadingIcon",
      "required": false,
      "description": "操作の意味を補強するアイコン。装飾だけのアイコンは aria-hidden にする。"
    },
    {
      "part": "trailingIcon",
      "required": false,
      "description": "遷移、展開、外部リンクなど、操作後の方向を補足するアイコン。"
    },
    {
      "part": "spinner",
      "required": false,
      "description": "loading 中の進行表示。aria-hiddenにし、ラベルnode、accessible name、Button幅を保持する。"
    }
  ],
  "variants": {
    "primary": {
      "intent": "画面内の最重要アクション。原則として 1 画面または 1 文脈に 1 つ。",
      "tokenRefs": {
        "background": "--button-primary-bg",
        "foreground": "--button-primary-fg",
        "border": "transparent"
      },
      "states": {
        "hover": { "background": "--button-primary-bg-hover" },
        "active": { "background": "--button-primary-bg-active" },
        "disabled": { "background": "--disabled", "foreground": "--fg-disabled", "border": "transparent" }
      }
    },
    "secondary": {
      "intent": "主要アクションに次ぐ補助アクション。キャンセルより強く、primary より弱い。",
      "tokenRefs": {
        "background": "--control-bg",
        "foreground": "--fg",
        "border": "--control-border"
      },
      "states": {
        "hover": { "background": "--control-bg-hover", "border": "--control-border-hover" },
        "active": { "background": "--control-bg-active", "border": "--control-border-hover" },
        "disabled": { "background": "--control-bg", "foreground": "--fg-disabled", "border": "--control-border" }
      }
    },
    "tertiary": {
      "intent": "低優先だが見つけやすくしたいアクション。選択済みや軽い強調にも使う。",
      "tokenRefs": {
        "background": "--primary-subtle",
        "foreground": "--primary",
        "border": "transparent"
      },
      "states": {
        "hover": { "background": "--primary-muted" },
        "active": { "background": "--primary-muted" },
        "disabled": { "background": "--surface-muted", "foreground": "--fg-disabled", "border": "transparent" }
      }
    },
    "ghost": {
      "intent": "ツールバー、行内、ダイアログのキャンセルなど、面を増やしたくない補助操作。",
      "tokenRefs": {
        "background": "transparent",
        "foreground": "--fg",
        "border": "transparent"
      },
      "states": {
        "hover": { "background": "--surface-muted" },
        "active": { "background": "--control-bg-active" },
        "disabled": { "background": "transparent", "foreground": "--fg-disabled", "border": "transparent" }
      }
    },
    "danger": {
      "intent": "削除、取り消し不能、権限剥奪など破壊的な最終操作。確認 UI と併用する。",
      "tokenRefs": {
        "background": "--danger",
        "foreground": "--danger-on-solid",
        "border": "transparent"
      },
      "states": {
        "hover": { "background": "--danger-hover" },
        "active": { "background": "--danger-active" },
        "disabled": { "background": "--disabled", "foreground": "--fg-disabled", "border": "transparent" }
      }
    }
  },
  "sizes": {
    "xs": {
      "controlHeight": "--ctl-xs",
      "paddingInline": ["--sp-2", "--sp-2"],
      "gap": "--sp-1",
      "textToken": "--text-micro",
      "iconSize": "--button-icon-size-xs"
    },
    "sm": {
      "controlHeight": "--ctl-sm",
      "paddingInline": ["--sp-25", "--sp-25"],
      "gap": "--sp-15",
      "textToken": "--text-small",
      "iconSize": "--button-icon-size-sm"
    },
    "md": {
      "controlHeight": "--ctl-md",
      "paddingInline": ["--sp-3", "--sp-3"],
      "gap": "--sp-2",
      "textToken": "--text-label",
      "iconSize": "--button-icon-size-md"
    },
    "lg": {
      "controlHeight": "--ctl-lg",
      "paddingInline": ["--sp-4", "--sp-4"],
      "gap": "--sp-2",
      "textToken": "--text-body",
      "iconSize": "--button-icon-size-lg"
    },
    "xl": {
      "controlHeight": "--ctl-xl",
      "paddingInline": ["--sp-5", "--sp-5"],
      "gap": "--sp-25",
      "textToken": "--text-body",
      "iconSize": "--button-icon-size-xl"
    }
  },
  "states": [
    {
      "id": "default",
      "description": "操作可能な通常状態。",
      "requiredBehavior": ["button 要素としてフォーカス可能", "variant と size の既定 token を使う"]
    },
    {
      "id": "hover",
      "description": "ポインタが乗った状態。",
      "requiredBehavior": ["色または面の変化は token で表す", "hover だけに意味を依存しない"]
    },
    {
      "id": "active",
      "description": "押下中の状態。",
      "requiredBehavior": ["短い motion token で状態変化を伝える", "レイアウト寸法を変えない"]
    },
    {
      "id": "focus",
      "description": "キーボードフォーカスがある状態。",
      "requiredBehavior": ["focus-visible で --focus-ring を表示", "outline を消す場合は必ず代替リングを持つ"]
    },
    {
      "id": "disabled",
      "description": "操作不可の状態。",
      "requiredBehavior": ["disabled propはnative disabledへ写像する", "理由が必要な場合は周辺説明とaria-describedbyを併用する"]
    },
    {
      "id": "loading",
      "description": "実行中の状態。",
      "requiredBehavior": ["aria-busy=\"true\"とaria-disabled=\"true\"を設定", "clickとsubmitの再実行をguardする", "ラベルnode、accessible name、Button幅を維持", "spinner表示中はラベル文字を視覚的に透明化する", "フォーカスを移動しない"]
    }
  ],
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "default": null,
      "description": "操作結果を示す可視ラベル。テキストを含め、アイコンだけにしない。"
    },
    {
      "name": "variant",
      "type": "\"primary\" | \"secondary\" | \"tertiary\" | \"ghost\" | \"danger\"",
      "required": false,
      "default": "primary",
      "description": "視覚的な優先度と文脈。"
    },
    {
      "name": "size",
      "type": "\"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\"",
      "required": false,
      "default": "md",
      "description": "密度 token に連動する高さと余白。"
    },
    {
      "name": "leadingIcon",
      "type": "ReactNode",
      "required": false,
      "default": null,
      "description": "ラベルの意味を補強する先頭アイコン。装飾としてaria-hiddenにする。"
    },
    {
      "name": "trailingIcon",
      "type": "ReactNode",
      "required": false,
      "default": null,
      "description": "展開や次方向を補足する末尾アイコン。装飾としてaria-hiddenにする。"
    },
    {
      "name": "loading",
      "type": "boolean",
      "required": false,
      "default": "false",
      "description": "実行中表示。aria-busy と二重送信防止を伴う。"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "default": "false",
      "description": "操作不可。フォーム送信対象から外す場合に使う。"
    },
    {
      "name": "fullWidth",
      "type": "boolean",
      "required": false,
      "default": "false",
      "description": "親コンテナ幅いっぱいに広げる。モバイルの主要アクションで使う。"
    },
    {
      "name": "type",
      "type": "\"button\" | \"submit\" | \"reset\"",
      "required": false,
      "default": "button",
      "description": "native button type。フォーム送信時だけsubmitを明示する。"
    },
    {
      "name": "ref",
      "type": "ForwardedRef<HTMLButtonElement>",
      "required": false,
      "default": null,
      "description": "native button要素へforwardするref。"
    }
  ],
