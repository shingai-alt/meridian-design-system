    { "id": "invalid", "description": "Client validation error。", "requiredBehavior": ["Errorをtextで特定する", "aria-invalidとdescriptionを同期する", "最初のinvalid controlへfocusする"] },
    { "id": "submitting", "description": "送信中で二重実行を防ぐ。", "requiredBehavior": ["入力を保持する", "Primary actionをbusyかつdisabledにする", "送信中をtextで伝える"] },
    { "id": "error", "description": "Server rejection後も修正または再試行できる。", "requiredBehavior": ["入力とRoleを保持する", "理由と回復経路を示す", "Error summaryへfocusする"] }
  ],
