    { "part": "dialog", "required": true, "description": "Modal lifecycleをDialogへ委譲するnative dialog。" },
    { "part": "title", "required": true, "description": "固定label『メンバーを招待』。" },
    { "part": "description", "required": true, "description": "Workspaceと単一招待であることを示す短い説明。" },
    { "part": "email-field", "required": true, "description": "type=email、requiredの単一Email input。" },
    { "part": "role-field", "required": true, "description": "Role名を選ぶnative Select。" },
    { "part": "role-description", "required": true, "description": "選択中Roleの権限を示す可視text。" },
    { "part": "error-message", "required": false, "description": "Field errorまたはserver rejectionと回復方法。" },
    { "part": "footer", "required": true, "description": "Cancelと招待を送信。" }
  ],
  "variants": { "default": { "intent": "単一memberの通常招待。", "tokenRefs": {}, "states": {} } },
  "sizes": {},
