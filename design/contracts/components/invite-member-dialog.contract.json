    "mobile": { "summary": "同じ意味とAPIでviewport-safe Dialogへ適応する。", "rules": ["Fieldsとactionsをsingle columnにする", "Software keyboardでもfield、error、footerへscrollできる"], "avoid": ["別componentへ分岐する", "横overflowを起こす"] },
    "touch": { "summary": "Close、Cancel、Sendを単一pointerで操作する。", "rules": ["全targetは24px minimum、主要actionは44px推奨"], "avoid": ["Gestureだけをdismiss経路にする"] }
  },
  "rules": ["NO_RAW_HEX_COLOR", "SPACING_FROM_TOKENS_ONLY", "RADIUS_FROM_TOKENS_ONLY", "CONTRAST_AA_MINIMUM", "FOCUS_VISIBLE_REQUIRED", "NO_POSITIVE_TABINDEX", "TARGET_SIZE_MINIMUM", "INTERACTIVE_NAME_REQUIRED"],
