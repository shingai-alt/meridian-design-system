{
  "$schema": "../../../schemas/component-contract.schema.json",
  "schemaVersion": "0.1.0",
  "contractVersion": "0.1.0",
  "runtime": {
    "compatibility": ">=0.1.0 <1.0.0",
    "rootElements": ["select"],
    "slots": ["control", "option"],
    "attributes": ["value", "disabled", "aria-invalid", "aria-labelledby", "aria-describedby"],
    "stateModel": ["native-attributes", "data-meridian-state"],
    "events": ["change"],
    "relations": ["labelledby", "describedby", "error-message"],
    "provenance": ["component", "instance", "variant", "state", "contract-version", "runtime-version", "decision"]
  },
  "selectionRules": { "useWhen": ["有限の候補から1つを選ぶ。"], "avoidWhen": ["自由入力または少数の常時比較には使わない。"], "alternatives": ["text-field", "radio", "combobox"] },
  "negativeExamples": [{ "pattern": "native selectをdivとclick handlerで再実装する。", "reason": "keyboardとname/value semanticsを失うため。", "ruleIds": ["INTERACTIVE_NAME_REQUIRED"] }],
  "requiredScenarios": ["default", "error", "disabled", "focus"],
  "id": "select",
  "name": "Select",
  "status": "draft",
  "category": "forms",
  "description": "定義済みの選択肢から 1 つを選ぶ。5〜15 個程度の選択肢に向く。",
  "source": {
    "humanDoc": "components/select.md",
    "registry": "js/components-registry.js#select"
  },
  "intent": {
    "whenToUse": [
      "選択肢が 5 個以上で 1 つだけ選ぶ"
    ],
    "whenNotToUse": [
      "4 個以下 → Radio / Segmented Control",
      "検索が必要な多数の選択肢 → Combobox"
    ],
    "principles": [
      1,
      2,
      3,
      5,
      6
    ]
  },
  "anatomy": [
    {
      "part": "root",
      "required": true,
      "description": "Selection control boundary."
    },
    {
      "part": "value",
      "required": true,
      "description": "Current value or selected option."
    },
    {
      "part": "indicator",
      "required": true,
      "description": "Selection, thumb, check, or disclosure indicator."
    },
    {
      "part": "popup",
      "required": false,
      "description": "Option list or calendar when the pattern opens one."
    }
  ],
  "variants": {
    "default": {
      "intent": "標準文脈。",
      "tokenRefs": {},
      "states": {}
    }
  },
  "sizes": {
    "sm": {
      "controlHeight": "--ctl-sm",
      "paddingInline": [
        "--sp-2",
        "--sp-2"
