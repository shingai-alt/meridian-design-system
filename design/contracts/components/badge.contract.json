  "schemaVersion": "0.1.0",
  "id": "badge",
  "name": "Badge",
  "status": "draft",
  "category": "core",
  "description": "状態やカテゴリを示す小さなラベル。読み取り専用で、操作は持たない。",
  "source": {
    "humanDoc": "components/badge.md",
    "registry": "js/components-registry.js#badge"
  },
  "intent": {
    "whenToUse": [
      "ステータス表示(Active / Failed など)",
      "件数・カテゴリの補足"
    ],
    "whenNotToUse": [
      "削除可能な属性 → Tag",
      "クリックで絞り込む操作 → Filter chip(Tag の亜種)"
    ],
    "principles": [
      1,
      2,
      3,
      5,
      6
    ]
  },
  "anatomy": [
    {
      "part": "root",
      "required": true,
      "description": "Semantic display root."
    },
    {
      "part": "content",
      "required": true,
      "description": "Primary perceivable content."
    },
    {
      "part": "supporting",
      "required": false,
      "description": "Optional metadata or visual reinforcement."
    }
  ],
  "variants": {
    "neutral": {
      "intent": "neutralという明示的な意味を持つ文脈。",
      "tokenRefs": {},
      "states": {}
    },
    "primary": {
      "intent": "主要actionまたは最優先の選択。",
      "tokenRefs": {},
      "states": {}
    },
    "success": {
      "intent": "完了または肯定的状態。",
      "tokenRefs": {},
      "states": {}
    },
    "warning": {
      "intent": "注意と判断が必要な状態。",
      "tokenRefs": {},
      "states": {}
    },
    "danger": {
      "intent": "破壊的または回復困難な操作・状態。",
      "tokenRefs": {},
      "states": {}
    },
    "info": {
      "intent": "中立的な補足情報。",
      "tokenRefs": {},
      "states": {}
    }
  },
  "sizes": {},
  "states": [
    {
      "id": "default",
      "description": "通常状態。意味、label、valueを省略しない。",
      "requiredBehavior": [
        "通常状態。意味、label、valueを省略しない。"
      ]
    }
  ],
  "props": [
    {
      "name": "variant",
      "type": "\"neutral\" | \"primary\" | \"success\" | \"warning\" | \"danger\" | \"info\"",
      "required": false,
      "default": "neutral",
      "description": "意味と優先度を選ぶ。"
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Label"
    },
    {
      "name": "dot",
      "type": "boolean",
      "required": false,
      "default": "false",
      "description": "Status dot"
    },
    {
      "name": "outline",
      "type": "boolean",
      "required": false,
      "default": "false",
      "description": "Outline"
    }
  ],
