  "accessibility": {
    "requirements": [
      "role=\"combobox\" + aria-expanded + aria-activedescendant を実装する",
      "候補リストは role=\"listbox\" にする",
      "Keyboardとpointerで同じ機能を実行できる。",
      "Focus indicatorを常に視認でき、sticky layerで完全に隠さない。",
      "Targetは24px minimumを満たし、主要touch操作は原則44px以上にする。"
    ],
    "aria": [
      "role=\"combobox\"、aria-expanded、aria-controls、active option関係を同期する。"
    ],
    "focus": [
      "focus-visibleで--focus-ringを使う。",
      "Positive tabindexを使わず、DOMとvisualの順序を一致させる。"
    ]
  },
  "keyboardInteractions": [
    {
      "key": "Arrow Up / Down",
      "action": "Popup optionを移動する。"
    },
    {
      "key": "Enter",
      "action": "Active optionを選択する。"
    },
    {
      "key": "Escape",
      "action": "Popupを閉じる。"
    }
  ],
  "usagePatterns": [
    {
      "id": "recommended-1",
      "title": "Primary context",
      "description": "候補が 15 個を超える選択",
      "recommended": [
        "0 件時は「一致する候補がありません」と、新規作成の導線を出す。"
      ],
      "avoid": [
        "固定の少数選択 → Select"
      ]
    },
    {
      "id": "recommended-2",
      "title": "Secondary context",
      "description": "メンバー・リポジトリなど動的な候補",
      "recommended": [
        "選択済み項目は Tag で表示し、個別に解除できるようにする。"
      ],
      "avoid": [
        "固定の少数選択 → Select"
      ]
    }
  ],
  "responsiveBehavior": {
    "desktop": {
      "summary": "DesktopでのCombobox。",
      "rules": [
        "周辺layoutに応じたintrinsic widthを基本にし、formではlabelとの整列を保つ。",
        "Keyboard focusとhoverを別々に確認する。"
      ],
      "avoid": [
        "Hoverだけで状態や操作を伝えない。"
      ]
    },
    "mobile": {
      "summary": "MobileでのCombobox。",
      "rules": [
        "Form文脈では利用可能幅まで広げ、複数controlを無理に横へ詰めない。",
        "同じpropとstate contractを維持する。"
      ],
      "avoid": [
        "PC用とSP用に意味やAPIの異なるcomponentを複製しない。"
      ]
    },
    "touch": {
      "summary": "Touch入力でのCombobox。",
      "rules": [
        "Pointer targetは24px minimumを満たし、touch中心の主要操作は原則44px以上にする。",
        "Hoverだけに情報や操作を依存させず、連打とdragには同等の非gesture操作を用意する。"
      ],
      "avoid": [
        "小さな隣接targetやgestureだけの操作を作らない。"
      ]
    }
  },
  "rules": [
    "NO_RAW_HEX_COLOR",
    "SPACING_FROM_TOKENS_ONLY",
    "RADIUS_FROM_TOKENS_ONLY",
    "CONTRAST_AA_MINIMUM",
    "FOCUS_VISIBLE_REQUIRED",
    "NO_POSITIVE_TABINDEX",
    "TARGET_SIZE_MINIMUM",
    "INTERACTIVE_NAME_REQUIRED"
  ],
  "qualityChecks": [
    "When to use / not useの境界が明確",
    "PC / SP / touchで同じsemantic contractを維持",
    "公開tokenだけを参照",
    "Keyboardとaccessible nameを検証",
    "Light / Dark × Standard / Highと3 densityで確認"
  ],
  "examples": [
    {
      "id": "default",
      "description": "Comboboxの標準例。",
      "code": "<Combobox\n  label=\"メンバー\"\n  items={members}\n  itemToString={(m) => m.name}\n  onSelect={...}\n/>"
    }
  ],
  "openQuestions": [
    "React package実装時にDOM/ref/event APIと全visual slot bindingを確定し、coverage completeでstableへ移行する。"
  ]
}
