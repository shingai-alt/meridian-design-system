  "accessibility": {
    "requirements": [
      "Keyboardとpointerで同じ機能を実行できる。",
      "Focus indicatorを常に視認でき、sticky layerで完全に隠さない。",
      "Targetは24px minimumを満たし、主要touch操作は原則44px以上にする。"
    ],
    "aria": [
      "Native semanticsを優先し、ARIAは不足する関係と状態だけを補う。"
    ],
    "focus": [
      "focus-visibleで--focus-ringを使う。",
      "Positive tabindexを使わず、DOMとvisualの順序を一致させる。"
    ]
  },
  "keyboardInteractions": [
    {
      "key": "Tab",
      "action": "順序どおりにfocusを移動する。"
    }
  ],
  "usagePatterns": [
    {
      "id": "recommended-1",
      "title": "Primary context",
      "description": "複数通知を未読状態と遷移先付きで確認するとき。",
      "recommended": [
        "未読は primary-subtle 背景で示す。"
      ],
      "avoid": [
        "単発の操作結果にはToastを使う。"
      ]
    }
  ],
  "responsiveBehavior": {
    "desktop": {
      "summary": "DesktopでのNotification Center。",
      "rules": [
        "Notification Centerは内容に応じたmax-widthを持ち、背景文脈を保つ。",
        "Focusをsurface内で管理し、閉じたらtriggerへ戻す。"
      ],
      "avoid": [
        "Hoverだけで状態や操作を伝えない。"
      ]
    },
    "mobile": {
      "summary": "MobileでのNotification Center。",
      "rules": [
        "Viewportに収まらない固定幅を使わず、必要に応じてfull-screenまたはbottom-aligned presentationへ切り替える。",
        "Safe areaとsoftware keyboardを考慮し、primary actionを見失わせない。"
      ],
      "avoid": [
        "PC用とSP用に意味やAPIの異なるcomponentを複製しない。"
      ]
    },
    "touch": {
      "summary": "Touch入力でのNotification Center。",
      "rules": [
        "Pointer targetは24px minimumを満たし、touch中心の主要操作は原則44px以上にする。",
        "Hoverだけに情報や操作を依存させず、連打とdragには同等の非gesture操作を用意する。"
      ],
      "avoid": [
        "小さな隣接targetやgestureだけの操作を作らない。"
      ]
    }
  },
  "rules": [
    "NO_RAW_HEX_COLOR",
    "SPACING_FROM_TOKENS_ONLY",
    "RADIUS_FROM_TOKENS_ONLY",
    "CONTRAST_AA_MINIMUM",
    "FOCUS_VISIBLE_REQUIRED",
    "NO_POSITIVE_TABINDEX",
    "TARGET_SIZE_MINIMUM",
    "INTERACTIVE_NAME_REQUIRED"
  ],
  "qualityChecks": [
    "When to use / not useの境界が明確",
    "PC / SP / touchで同じsemantic contractを維持",
    "公開tokenだけを参照",
    "Keyboardとaccessible nameを検証",
    "Light / Dark × Standard / Highと3 densityで確認"
  ],
  "examples": [
    {
      "id": "default",
      "description": "Notification Centerの標準例。",
      "code": "<NotificationCenter\n  notifications={items}\n  onMarkAllRead={markAll}\n  onItemClick={open}\n/>"
    }
  ],
  "openQuestions": [
    "React package実装時にDOM/ref/event APIと全visual slot bindingを確定し、coverage completeでstableへ移行する。"
  ]
}
