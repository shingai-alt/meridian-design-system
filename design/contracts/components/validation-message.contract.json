  "accessibility": {
    "requirements": [
      "role=\"alert\" または aria-live=\"polite\" で通知する",
      "表示専用rootを不要にtab順へ追加しない。",
      "状態は色だけで表さずtext、icon、shapeを併用する。"
    ],
    "aria": [
      "Native semanticsを優先し、ARIAは不足する関係と状態だけを補う。"
    ],
    "focus": [
      "Nested controlがある場合だけ、そのcontrolがfocusを受け取る。"
    ]
  },
  "keyboardInteractions": [],
  "usagePatterns": [
    {
      "id": "recommended-1",
      "title": "Primary context",
      "description": "フィールド単位の検証結果",
      "recommended": [
        "「何が悪いか」+「どう直すか」を 1 文で書く。"
      ],
      "avoid": [
        "フォーム全体・API 起因のエラー → Alert"
      ]
    }
  ],
  "responsiveBehavior": {
    "desktop": {
      "summary": "DesktopでのValidation Message。",
      "rules": [
        "Contentと周辺layoutに応じたintrinsic sizeを使う。",
        "Viewportだけを理由にdensityを変更しない。"
      ],
      "avoid": [
        "Hoverだけで状態や操作を伝えない。"
      ]
    },
    "mobile": {
      "summary": "MobileでのValidation Message。",
      "rules": [
        "意味とDOM順を変えず、wrapとavailable widthで適応する。",
        "省略した情報へ別経路から到達できるようにする。"
      ],
      "avoid": [
        "PC用とSP用に意味やAPIの異なるcomponentを複製しない。"
      ]
    },
    "touch": {
      "summary": "Touch入力でのValidation Message。",
      "rules": [
        "表示専用rootをtab順へ追加しない。",
        "内包する操作がある場合だけ、その操作targetを24px minimum、主要touch操作を原則44px以上にする。"
      ],
      "avoid": [
        "小さな隣接targetやgestureだけの操作を作らない。"
      ]
    }
  },
  "rules": [
    "NO_RAW_HEX_COLOR",
    "SPACING_FROM_TOKENS_ONLY",
    "RADIUS_FROM_TOKENS_ONLY",
    "CONTRAST_AA_MINIMUM",
    "STATE_NOT_COLOR_ONLY"
  ],
  "qualityChecks": [
    "When to use / not useの境界が明確",
    "PC / SP / touchで同じsemantic contractを維持",
    "公開tokenだけを参照",
    "Keyboardとaccessible nameを検証",
    "Light / Dark × Standard / Highと3 densityで確認"
  ],
