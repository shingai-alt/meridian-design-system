  "accessibility": {
    "requirements": [
      "表示専用rootを不要にtab順へ追加しない。",
      "状態は色だけで表さずtext、icon、shapeを併用する。"
    ],
    "aria": [
      "Urgentで自動提示される内容だけrole=\"alert\"を使う。"
    ],
    "focus": [
      "Nested controlがある場合だけ、そのcontrolがfocusを受け取る。"
    ]
  },
  "keyboardInteractions": [],
  "usagePatterns": [
    {
      "id": "recommended-1",
      "title": "Primary context",
      "description": "フォーム全体のエラー",
      "recommended": [
        "タイトル 1 行+本文 1〜2 文に収める。"
      ],
      "avoid": [
        "一時的な操作結果 → Toast"
      ]
    },
    {
      "id": "recommended-2",
      "title": "Secondary context",
      "description": "セクションに関する注意・状態",
      "recommended": [
        "danger にはリカバリー手段(再試行・ログ確認)への導線を含める。"
      ],
      "avoid": [
        "サイト全体のお知らせ → Banner"
      ]
    }
  ],
  "responsiveBehavior": {
    "desktop": {
      "summary": "DesktopでのAlert。",
      "rules": [
        "Gridまたはsectionのreading orderに沿って配置し、同種itemの寸法を揃える。",
        "面の入れ子を増やさない。"
      ],
      "avoid": [
        "Hoverだけで状態や操作を伝えない。"
      ]
    },
    "mobile": {
      "summary": "MobileでのAlert。",
      "rules": [
        "1列へreflowし、heading、content、actionの順序を保つ。",
        "Actionが複数ある場合は縦積みまたはmenuへ整理する。"
      ],
      "avoid": [
        "PC用とSP用に意味やAPIの異なるcomponentを複製しない。"
      ]
    },
    "touch": {
      "summary": "Touch入力でのAlert。",
      "rules": [
        "表示専用rootをtab順へ追加しない。",
        "内包する操作がある場合だけ、その操作targetを24px minimum、主要touch操作を原則44px以上にする。"
      ],
      "avoid": [
        "小さな隣接targetやgestureだけの操作を作らない。"
      ]
    }
  },
  "rules": [
    "NO_RAW_HEX_COLOR",
    "SPACING_FROM_TOKENS_ONLY",
    "RADIUS_FROM_TOKENS_ONLY",
    "CONTRAST_AA_MINIMUM",
    "STATE_NOT_COLOR_ONLY"
  ],
  "qualityChecks": [
    "When to use / not useの境界が明確",
    "PC / SP / touchで同じsemantic contractを維持",
    "公開tokenだけを参照",
    "Keyboardとaccessible nameを検証",
    "Light / Dark × Standard / Highと3 densityで確認"
  ],
  "examples": [
    {
      "id": "default",
      "description": "Alertの標準例。",
      "code": "<Alert tone=\"info\" title=\"…\">\n  本文テキスト\n</Alert>"
    }
  ],
  "openQuestions": [
    "React package実装時にDOM/ref/event APIと全visual slot bindingを確定し、coverage completeでstableへ移行する。"
  ]
}
