    "compatibility": ">=0.1.0 <1.0.0",
    "rootElements": ["div", "section"],
    "slots": ["title", "message", "actions"],
    "attributes": ["role", "aria-labelledby"],
    "stateModel": ["data-meridian-variant"],
    "events": [],
    "relations": ["labelledby", "live-announcement-owned-externally"],
    "provenance": ["component", "instance", "variant", "state", "contract-version", "runtime-version", "decision"]
  },
  "selectionRules": { "useWhen": ["pageまたはsectionの状態、影響、回復行動を示す。"], "avoidWhen": ["短い反復状態やfield単位errorには使わない。"], "alternatives": ["status-indicator", "validation-message"] },
  "negativeExamples": [{ "pattern": "任意のHTML文字列をAlert bodyへ挿入する。", "reason": "Contract外DOMとinjectionを許すため。", "ruleIds": ["NO_RAW_HEX_COLOR"] }],
  "requiredScenarios": ["info", "success", "warning", "danger", "labelledby"],
  "id": "alert",
  "name": "Alert",
  "status": "draft",
  "category": "feedback",
  "description": "ページ・セクション内に埋め込む恒常的な通知。文脈に密着した情報を伝える。",
  "source": {
    "humanDoc": "components/alert.md",
    "registry": "js/components-registry.js#alert"
  },
  "intent": {
    "whenToUse": [
      "フォーム全体のエラー",
      "セクションに関する注意・状態"
    ],
    "whenNotToUse": [
      "一時的な操作結果 → Toast",
      "サイト全体のお知らせ → Banner"
    ],
    "principles": [
      1,
      2,
      3,
      5,
      6
    ]
  },
  "anatomy": [
    {
      "part": "root",
      "required": true,
      "description": "Status message boundary."
    },
    {
      "part": "indicator",
      "required": false,
      "description": "Icon or shape that reinforces tone."
    },
    {
      "part": "message",
      "required": true,
      "description": "Concise status and recovery guidance."
    },
    {
      "part": "action",
      "required": false,
      "description": "Recovery, undo, or dismiss control."
    }
  ],
  "variants": {
    "info": {
      "intent": "中立的な補足情報。",
      "tokenRefs": {},
      "states": {}
    },
    "success": {
      "intent": "完了または肯定的状態。",
      "tokenRefs": {},
      "states": {}
    },
    "warning": {
      "intent": "注意と判断が必要な状態。",
      "tokenRefs": {},
      "states": {}
    },
    "danger": {
      "intent": "破壊的または回復困難な操作・状態。",
      "tokenRefs": {},
      "states": {}
    }
  },
  "sizes": {},
  "states": [
    {
      "id": "default",
      "description": "通常状態。意味、label、valueを省略しない。",
      "requiredBehavior": [
        "通常状態。意味、label、valueを省略しない。"
      ]
    }
  ],
  "props": [
    {
      "name": "variant",
      "type": "\"info\" | \"success\" | \"warning\" | \"danger\"",
      "required": false,
      "default": "info",
      "description": "意味と優先度を選ぶ。"
