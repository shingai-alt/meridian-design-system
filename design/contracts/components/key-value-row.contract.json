  "usagePatterns": [
    {
      "id": "recommended-1",
      "title": "Primary context",
      "description": "Description List内で1組のlabel/valueを構成するとき。",
      "recommended": [
        "Keyは短く一定幅にし、Valueは折り返しとcopyを許可する。"
      ],
      "avoid": [
        "単独で意味のあるsectionや編集可能fieldには使わない。"
      ]
    }
  ],
  "responsiveBehavior": {
    "desktop": {
      "summary": "DesktopでのKey Value Row。",
      "rules": [
        "Contentと周辺layoutに応じたintrinsic sizeを使う。",
        "Viewportだけを理由にdensityを変更しない。"
      ],
      "avoid": [
        "Hoverだけで状態や操作を伝えない。"
      ]
    },
    "mobile": {
      "summary": "MobileでのKey Value Row。",
      "rules": [
        "意味とDOM順を変えず、wrapとavailable widthで適応する。",
        "省略した情報へ別経路から到達できるようにする。"
      ],
      "avoid": [
        "PC用とSP用に意味やAPIの異なるcomponentを複製しない。"
      ]
    },
    "touch": {
      "summary": "Touch入力でのKey Value Row。",
      "rules": [
        "表示専用rootをtab順へ追加しない。",
        "内包する操作がある場合だけ、その操作targetを24px minimum、主要touch操作を原則44px以上にする。"
      ],
      "avoid": [
        "小さな隣接targetやgestureだけの操作を作らない。"
      ]
    }
  },
  "rules": [
    "NO_RAW_HEX_COLOR",
