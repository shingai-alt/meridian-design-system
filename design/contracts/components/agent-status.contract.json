    "whenToUse": [
      "agent全体の現在状態と停止・再試行actionを示すとき。"
    ],
    "whenNotToUse": [
      "個別stepの履歴にはExecution Timelineを使う。"
    ],
    "principles": [
      1,
      2,
      3,
      5,
      6
    ]
  },
