  "accessibility": {
    "requirements": [
      "表示専用rootを不要にtab順へ追加しない。",
      "状態は色だけで表さずtext、icon、shapeを併用する。"
    ],
    "aria": [
      "Native semanticsを優先し、ARIAは不足する関係と状態だけを補う。"
    ],
    "focus": [
      "Nested controlがある場合だけ、そのcontrolがfocusを受け取る。"
    ]
  },
  "keyboardInteractions": [],
  "usagePatterns": [
    {
      "id": "recommended-1",
      "title": "Primary context",
      "description": "誰が何をいつ行ったかを連続して確認するとき。",
      "recommended": [
        "「誰が」「何を」「いつ」の順で 1 行に収める。"
      ],
      "avoid": [
        "system event中心の監査履歴にはTimelineを使う。"
      ]
    }
  ],
  "responsiveBehavior": {
    "desktop": {
      "summary": "DesktopでのActivity Feed。",
      "rules": [
        "CompactまたはDefault densityで走査性を優先し、metadataとactionの列を安定させる。",
        "Hover actionはfocusでも表示する。"
      ],
      "avoid": [
        "Hoverだけで状態や操作を伝えない。"
      ]
    },
    "mobile": {
      "summary": "MobileでのActivity Feed。",
      "rules": [
        "主情報を先にしてmetadataを折り返し、非表示情報にはdetail viewから到達できるようにする。",
        "行全体clickだけに依存せず明示的なtargetを残す。"
      ],
      "avoid": [
        "PC用とSP用に意味やAPIの異なるcomponentを複製しない。"
      ]
    },
    "touch": {
      "summary": "Touch入力でのActivity Feed。",
      "rules": [
        "表示専用rootをtab順へ追加しない。",
        "内包する操作がある場合だけ、その操作targetを24px minimum、主要touch操作を原則44px以上にする。"
      ],
      "avoid": [
        "小さな隣接targetやgestureだけの操作を作らない。"
      ]
    }
  },
  "rules": [
    "NO_RAW_HEX_COLOR",
    "SPACING_FROM_TOKENS_ONLY",
    "RADIUS_FROM_TOKENS_ONLY",
    "CONTRAST_AA_MINIMUM"
  ],
  "qualityChecks": [
    "When to use / not useの境界が明確",
    "PC / SP / touchで同じsemantic contractを維持",
    "公開tokenだけを参照",
    "Keyboardとaccessible nameを検証",
    "Light / Dark × Standard / Highと3 densityで確認"
  ],
  "examples": [
    {
      "id": "default",
      "description": "Activity Feedの標準例。",
      "code": "<ActivityFeed items={events} groupBy=\"hour\" />"
    }
  ],
  "openQuestions": [
    "React package実装時にDOM/ref/event APIと全visual slot bindingを確定し、coverage completeでstableへ移行する。"
  ]
}
