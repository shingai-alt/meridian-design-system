  "selectionRules": {
    "useWhen": ["既に単独で理解できるtriggerへ短い補助説明やshortcutを加える。"],
    "avoidWhen": ["内容が操作に必須、長文、interactive、またはtouchだけでも到達必須である。"],
    "alternatives": ["Popover", "Form Field helper text", "Dialog", "visible text"]
  },
  "negativeExamples": [
    { "pattern": "Tooltip内へlinkやbuttonを置く。", "reason": "Tooltipはfocusを受けずinteractive contentを所有しないため。", "ruleIds": ["INTERACTIVE_NAME_REQUIRED"] },
    { "pattern": "Tooltipだけに操作名やvalidation instructionを置く。", "reason": "Touchや支援技術で必須情報へ到達できない可能性があるため。", "ruleIds": ["INTERACTIVE_NAME_REQUIRED"] }
  ],
  "requiredScenarios": ["default", "hover", "focus", "escape-dismiss", "viewport-collision", "default-variant"],
  "id": "tooltip",
  "name": "Tooltip",
  "status": "draft",
  "category": "core",
  "description": "Focusまたはhover中のtriggerへ、短い非interactive補足情報を関連付けるpopup。",
  "source": { "humanDoc": "components/tooltip.md", "registry": "js/components-registry.js#tooltip" },
  "intent": {
    "whenToUse": ["Icon Buttonの可視Tooltipを提供する。", "既に理解可能なcontrolへshortcutや短い補足を加える。"],
    "whenNotToUse": ["操作名、error、instructionなど必須情報の唯一の提供経路。", "Link、Button、form controlを含むinteractive popup。", "複数文または構造化された長い説明。", "Touch tapだけで開く補助UI。"],
    "principles": [1, 2, 3, 5, 6]
  },
  "anatomy": [
    { "part": "trigger", "required": true, "description": "単一のfocusable element。自身のaccessible nameをTooltipなしでも持つ。" },
    { "part": "surface", "required": true, "description": "role=tooltipを持つ非focusable popup。" },
    { "part": "content", "required": true, "description": "短いplain text。interactive descendantを持たない。" }
  ],
  "variants": {
    "default": {
      "intent": "短い補助説明をinverse surfaceで表示する唯一のvariant。",
      "tokenRefs": { "background": "--tooltip-bg", "foreground": "--bg", "radius": "--radius-xs", "shadow": "--shadow-md" },
      "states": { "hover": { "visibility": "visible" }, "focus": { "visibility": "visible" } }
    }
  },
  "sizes": {},
  "states": [
    { "id": "default", "description": "Triggerがhoverもfocusもされずsurfaceを表示しない。", "requiredBehavior": ["Tooltip nodeは関係を保てるが視覚的にhidden", "triggerのaccessible nameは単独で成立"] },
    { "id": "hover", "description": "Pointerがtriggerまたはsurface上にあり、delay後に表示する。", "requiredBehavior": ["既定400ms後に開く", "triggerとsurfaceの両方からpointerが離れたら即時に閉じる"] },
    { "id": "focus", "description": "Triggerがkeyboard focusを持つ間に表示する。", "requiredBehavior": ["focus後に表示", "Escapeまたはblurで閉じる", "focusはtriggerに保持"] }
  ],
  "props": [
    { "name": "children", "type": "ReactElement", "required": true, "default": null, "description": "単一のfocusable trigger。aria-describedbyとevent handlerを合成する。" },
    { "name": "content", "type": "string", "required": true, "default": null, "description": "短い非interactive説明。" },
    { "name": "placement", "type": "\"top\" | \"right\" | \"bottom\" | \"left\"", "required": false, "default": "top", "description": "希望位置。Collision時は反転またはshiftできる。" },
    { "name": "delayDuration", "type": "number", "required": false, "default": "400", "description": "Pointer hoverから表示までのmilliseconds。Keyboard focusにも不必要な長い遅延を加えない。" },
    { "name": "open", "type": "boolean", "required": false, "default": null, "description": "Controlled open state。" },
    { "name": "defaultOpen", "type": "boolean", "required": false, "default": "false", "description": "Uncontrolled initial state。TestとShowcase用途を含む。" },
    { "name": "onOpenChange", "type": "(open: boolean) => void", "required": false, "default": null, "description": "Open state変更通知。Escape、blur、pointer transitionを同じstateへ同期する。" }
  ],
  "tokenRefs": {
    "componentColor": ["--tooltip-bg"],
    "semanticColor": ["--surface-inverse", "--bg"],
    "spacing": ["--sp-1", "--sp-2"],
    "radius": ["--radius-xs"],
    "motion": ["--dur-fast", "--ease-standard"],
    "shadow": ["--shadow-md"],
    "typography": ["--text-micro"]
  },
  "tokenBindings": {
    "coverage": "complete",
    "bindings": [
      { "slot": "surface.background", "source": "--tooltip-bg", "scope": "component", "componentToken": "--tooltip-bg", "aliases": "--surface-inverse", "trigger": "component-anatomy", "reason": "Tooltip固有のinverse surfaceを公開境界へ固定する。" },
      { "slot": "content.foreground", "source": "--bg", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Inverse surface上の高contrast foregroundとしてtheme canvas roleを使う。" },
      { "slot": "surface.padding-block", "source": "--sp-1", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "短い補足文のblock padding。" },
      { "slot": "surface.padding-inline", "source": "--sp-2", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "短い補足文のinline padding。" },
      { "slot": "surface.trigger-gap", "source": "--sp-2", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Triggerとsurfaceの視覚分離。" },
      { "slot": "surface.radius", "source": "--radius-xs", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "小型floating surfaceのshape。" },
      { "slot": "surface.shadow", "source": "--shadow-md", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Triggerから浮いたlayerであることを示す。" },
      { "slot": "content.typography", "source": "--text-micro", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "短い補足用の最小公開text role。" },
      { "slot": "surface.motion-duration", "source": "--dur-fast", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Opacity transitionを短く保つ。" },
      { "slot": "surface.motion-easing", "source": "--ease-standard", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "System標準easingを使う。" },
      { "slot": "surface.pointer-events.closed", "source": "none", "scope": "literal", "componentToken": null, "aliases": null, "trigger": null, "reason": "Hidden surfaceがtrigger操作を遮らないようにする。" }
    ],
    "unboundSlots": []
  },
  "accessibility": {
    "requirements": ["TriggerはTooltipなしでも空でないaccessible nameを持つ。", "Tooltipは短い補足だけを含みfocusable descendantを持たない。", "Pointerとkeyboardの両方で同じ内容を表示できる。"],
    "aria": ["Surfaceはrole=tooltipとstable idを持つ。", "Triggerはsurface idをaria-describedbyで参照する。", "open stateをaria-expandedで表さない。"],
    "focus": ["Surfaceへfocusを移さない。", "Escape dismissal後もfocusをtriggerへ保持する。", "blurで閉じる。"]
  },
  "keyboardInteractions": [
    { "key": "Tab / Shift+Tab", "action": "Native順序でtriggerへ移動し、focus時にTooltipを表示する。" },
    { "key": "Escape", "action": "Tooltipを閉じ、focusをtriggerへ保持する。" }
  ],
  "usagePatterns": [
    { "id": "icon-button-label", "title": "Icon Button label", "description": "Glyphの意味を可視化する。", "recommended": ["Icon Buttonのlabelと同じ短い文字列を表示する。"], "avoid": ["Tooltipだけをaccessible nameのsourceにする。"] },
    { "id": "shortcut", "title": "Shortcut hint", "description": "既知actionへ補助shortcutを示す。", "recommended": ["操作名の後にshortcutを短く示す。"], "avoid": ["操作方法の長い説明を入れる。"] }
  ],
  "responsiveBehavior": {
    "desktop": { "summary": "Trigger近傍へ配置しviewport collisionを解決する。", "rules": ["Hoverとfocusの両方で到達可能", "端ではplacementを反転またはshift", "surfaceはtriggerまたは自身のhover中に維持"], "avoid": ["Viewport外へ切る", "Hoverだけで開く"] },
    "mobile": { "summary": "Tooltipをtouch必須情報の経路にしない。", "rules": ["Keyboard focusが存在する環境では同じcontractを維持", "必須説明は常時visible textまたはPopoverへ移す"], "avoid": ["Tapをtrigger本来のactionより先に消費する", "Tooltipをsheetへ自動変形する"] },
    "touch": { "summary": "TouchではTooltipをprogressive enhancementとして扱う。", "rules": ["Trigger自体が単独で理解可能", "Touchだけで必要な内容は別経路を提供"], "avoid": ["Long pressだけに依存する", "TapでTooltipを開くためactionを二段階にする"] }
  },
  "rules": ["INTERACTIVE_NAME_REQUIRED", "FOCUS_VISIBLE_REQUIRED", "NO_POSITIVE_TABINDEX", "NO_RAW_HEX_COLOR", "SPACING_FROM_TOKENS_ONLY"],
  "qualityChecks": ["aria-describedbyが存在するTooltip idを参照する。", "Escapeで閉じてもtrigger focusを失わない。", "Surfaceにfocusable descendantがない。", "Light/DarkとStandard/Highでcontent contrastを満たす。", "Viewport端でclippingしない。"],
  "examples": [
    { "id": "icon-button", "description": "Icon Buttonへ短い可視labelを付ける。", "code": "<Tooltip content=\"フィルターを開く\"><IconButton label=\"フィルターを開く\" icon={<FilterIcon />} /></Tooltip>" },
    { "id": "shortcut", "description": "既知commandへshortcutを補足する。", "code": "<Tooltip content=\"変更を保存 ⌘S\"><Button>保存</Button></Tooltip>" }
  ],
  "openQuestions": []
}
