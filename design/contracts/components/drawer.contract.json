    "registry": "js/components-registry.js#drawer"
  },
  "intent": {
    "whenToUse": [
      "一覧 → 詳細のクイックビュー",
      "補助的な設定・フィルタ"
    ],
    "whenNotToUse": [
      "独立した作業フロー → 専用ページ"
    ],
    "principles": [
      1,
      2,
      3,
      5,
      6
    ]
  },
  "anatomy": [
    {
      "part": "surface",
      "required": true,
      "description": "Floating or modal surface."
    },
    {
      "part": "header",
      "required": false,
      "description": "Title and context."
    },
    {
      "part": "content",
      "required": true,
      "description": "Information or controls owned by the surface."
    },
    {
      "part": "actions",
      "required": false,
      "description": "Confirmation, navigation, or dismiss controls."
    },
    {
      "part": "trigger",
      "required": false,
      "description": "Element that opens the surface and receives restored focus."
    }
  ],
  "variants": {
    "default": {
      "intent": "標準文脈。",
