{
  "$schema": "../../../schemas/component-contract.schema.json",
  "schemaVersion": "0.1.0",
  "contractVersion": "0.2.0",
  "id": "drawer",
  "name": "Drawer",
  "status": "draft",
  "category": "feedback",
  "description": "現在の画面文脈を視覚的に残しながら、画面端へ一時的な補助taskをmodal表示するside-aligned dialog。",
  "source": {
    "humanDoc": "components/drawer.md",
    "registry": "js/components-registry.js#drawer"
  },
  "intent": {
    "whenToUse": [
      "一覧から詳細を確認・軽く編集するquick view。",
      "現在の画面へ戻る前提のfilter、settings、補助form。",
      "Narrow viewportでSidebar navigationを一時的に提示するmodal container。"
    ],
    "whenNotToUse": [
      "短い確認や不可逆actionの判断はDialogを使う。",
      "常設navigationはSidebar、常設inspectorはlayout panelを使う。",
      "長いmulti-step workflowや固有URLが必要なtaskは専用pageを使う。"
    ],
    "principles": [1, 2, 3, 5, 6]
  },
  "anatomy": [
    { "part": "trigger", "required": true, "description": "Drawerを開き、close後にfocusを受け取るfocusable control。" },
    { "part": "backdrop", "required": true, "description": "背景を視覚的に抑え、背景contentがmodal中に操作不能であることを示す。" },
    { "part": "surface", "required": true, "description": "Native dialogとして画面端へ配置するmodal surface。" },
    { "part": "title", "required": true, "description": "aria-labelledbyでsurfaceを命名する可視heading。" },
    { "part": "close-control", "required": true, "description": "常に可視でaccessible nameを持つIcon Button。" },
    { "part": "body", "required": true, "description": "独立してscrollできる補助content。" },
    { "part": "footer", "required": false, "description": "Body scrollから独立して表示する補助action領域。" }
  ],
  "variants": {
    "default": { "intent": "Modalなside-aligned補助surface。", "tokenRefs": {}, "states": {} }
  },
  "sizes": {},
  "states": [
    {
      "id": "open",
      "description": "Native dialogをshowModal()でtop layerへ表示した状態。",
      "requiredBehavior": [
        "背景contentをinertにする",
        "Initial focusをDrawer内へ移す",
        "Tab sequenceをDrawer内に保持する",
        "triggerのaria-expandedをtrueにする"
      ]
    },
    {
      "id": "closed",
      "description": "Surfaceを表示せずtriggerだけが通常のdocument順にある状態。",
      "requiredBehavior": [
        "Dialog open attributeを残さない",
        "triggerのaria-expandedをfalseにする",
        "Close直後はtriggerまたは論理的な次のfocus先へ戻す"
      ]
    }
  ],
  "props": [
    { "name": "trigger", "type": "ReactElement", "required": true, "default": null, "description": "単一のfocusable trigger。aria-haspopup、aria-controls、aria-expanded、open handlerを合成する。" },
    { "name": "title", "type": "ReactNode", "required": true, "default": null, "description": "Drawerを命名する可視title。" },
    { "name": "children", "type": "ReactNode", "required": true, "default": null, "description": "Drawer body content。" },
    { "name": "footer", "type": "ReactNode", "required": false, "default": null, "description": "Body scrollから独立したaction領域。" },
    { "name": "open", "type": "boolean", "required": false, "default": null, "description": "Controlled open state。Native open attributeは直接toggleせずshowModal()/close()へ同期する。" },
    { "name": "defaultOpen", "type": "boolean", "required": false, "default": "false", "description": "Uncontrolled initial open state。" },
    { "name": "onOpenChange", "type": "(open: boolean) => void", "required": false, "default": null, "description": "Trigger、Escape、close control、backdrop requestを同じopen stateへ通知する。" },
    { "name": "side", "type": "\"inline-start\" | \"inline-end\"", "required": false, "default": "inline-end", "description": "RTLのdirectionに追従する論理的な表示端。" },
    { "name": "initialFocusRef", "type": "RefObject<HTMLElement | null>", "required": false, "default": null, "description": "Open時の明示的focus先。未指定時はcontent構造に応じた安全な既定を使う。" },
    { "name": "closeLabel", "type": "string", "required": false, "default": "閉じる", "description": "Close Icon Buttonのaccessible name。" },
    { "name": "ref", "type": "ForwardedRef<HTMLDialogElement>", "required": false, "default": null, "description": "Native dialog elementへforwardするref。" }
  ],
  "tokenRefs": {
    "semanticColor": ["--surface-overlay", "--border", "--fg", "--fg-muted", "--overlay"],
    "spacing": ["--sp-3", "--sp-4"],
    "typography": ["--text-label"],
    "motion": ["--dur-normal", "--ease-enter"],
    "layout": ["--drawer-w"],
    "shadow": ["--shadow-overlay"]
  },
  "tokenBindings": {
    "coverage": "complete",
    "bindings": [
      { "slot": "surface.background", "source": "--surface-overlay", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Modal contentを背景surfaceから分離する。" },
      { "slot": "surface.foreground", "source": "--fg", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Titleとbodyの基本foreground。" },
      { "slot": "surface.border-inline", "source": "--border", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "背景文脈との境界を表示端に作る。" },
      { "slot": "surface.inline-size", "source": "--drawer-w", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Detail/edit Drawerの標準幅を共有する。" },
      { "slot": "surface.radius", "source": "0", "scope": "literal", "componentToken": null, "aliases": null, "trigger": null, "reason": "Viewport edgeと連続するside surfaceはcard形状を持たない。" },
      { "slot": "surface.shadow", "source": "--shadow-overlay", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Top-layer surfaceを背景文脈から分離する。" },
      { "slot": "backdrop.background", "source": "--overlay", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "背景がmodal中に操作不能であることを視覚化する。" },
      { "slot": "header.padding", "source": "--sp-4", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Titleとviewport edgeを分離する。" },
      { "slot": "body.padding", "source": "--sp-4", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Scrollable contentの標準inset。" },
      { "slot": "footer.padding", "source": "--sp-3", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Actionsをcompactに区切る。" },
      { "slot": "header.gap", "source": "--sp-3", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Titleとclose controlのtargetを分離する。" },
      { "slot": "title.typography", "source": "--text-label", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Shell内のcompact heading role。" },
      { "slot": "secondary.foreground", "source": "--fg-muted", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Supporting metadataをtitleより弱くする。" },
      { "slot": "motion.duration", "source": "--dur-normal", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Side surfaceのenter motion。" },
      { "slot": "motion.easing", "source": "--ease-enter", "scope": "semantic", "componentToken": null, "aliases": null, "trigger": null, "reason": "Top-layer entryの標準curve。" }
    ],
    "unboundSlots": []
  },
  "accessibility": {
    "requirements": [
      "Native dialogをshowModal()で開き、背景contentを実際にinertにする。",
      "Visible title、常時visibleなclose control、24px minimum targetを持つ。",
      "主要touch操作は44px以上を推奨し、swipe gestureだけでcloseしない。"
    ],
    "aria": [
      "Dialogはaria-labelledbyで可視titleから命名する。",
      "Triggerはaria-haspopup=dialog、aria-controls、aria-expandedを同期する。",
      "Structured contentを一続きに読ませるaria-describedbyは既定で付けない。"
    ],
    "focus": [
      "Open時はinitialFocusRef、先頭の意味あるcontrol、またはtabindex=-1のstatic title/contentへfocusを移す。",
      "Tab / Shift+Tabをmodal内に保持し、close後はtriggerまたは論理的な次の要素へ戻す。",
      "Positive tabindexを使わず、body内のfocused elementをsticky footerで完全に隠さない。"
    ]
  },
  "keyboardInteractions": [
    { "key": "Tab / Shift+Tab", "action": "Open中はDrawer内のtabbable element間を循環する。" },
    { "key": "Escape", "action": "Cancel可能なclose requestを発行し、close後にtriggerへfocusを戻す。" }
  ],
  "usagePatterns": [
    { "id": "quick-detail", "title": "Quick detail", "description": "一覧の位置関係を視覚的に残して対象を確認する。", "recommended": ["短い確認・軽い編集に限定", "対象名をtitleへ含める"], "avoid": ["固有URLが必要な深いworkflow", "背景contentを操作可能なままにする"] },
    { "id": "supplementary-task", "title": "Supplementary task", "description": "Filterやsettingsを完了して元の画面へ戻る。", "recommended": ["Primary actionとclose経路を明示", "Unsaved stateはclose requestで確認"], "avoid": ["不可逆actionの最終確認", "複数page相当の入力"] },
    { "id": "mobile-navigation", "title": "Mobile navigation container", "description": "同じSidebar navigationをnarrow viewportで一時表示する。", "recommended": ["Drawerがmodal lifecycleを所有", "Sidebarはnav/list semanticsだけを所有"], "avoid": ["Sidebar側へfocus trapを重複実装", "Viewport専用navigation API"] }
  ],
  "responsiveBehavior": {
    "desktop": {
      "summary": "Inline-endを既定に背景文脈を視覚的に残す。",
      "rules": ["Inline sizeは--drawer-w、block sizeはdynamic viewport", "Bodyだけをscrollしheader/close/footerを到達可能に保つ", "Modal中は背景を操作不能にする"],
      "avoid": ["Non-modal inspectorとして流用", "Main content全体を不必要に覆う"]
    },
    "mobile": {
      "summary": "同じAPIとdialog semanticsのままviewport幅まで拡張する。",
      "rules": ["max-inline-sizeを100viに制限", "100dvbとsafe-areaを考慮", "Sidebar compositionでも同じclose/focus lifecycleを維持"],
      "avoid": ["PC用とSP用に分けません", "Fixed 420pxで横overflowを起こす"]
    },
    "touch": {
      "summary": "Visible close controlと単一pointer経路を維持する。",
      "rules": ["全targetは24px minimum、主要controlは44px以上推奨", "Backdrop tapはclose requestとして同じstate machineへ渡す", "Swipeを追加してもclose buttonとEscapeを残す"],
      "avoid": ["Swipe gestureだけで閉じる", "隣接する小さなtarget"]
    }
  },
  "rules": [
    "NO_RAW_HEX_COLOR",
    "SPACING_FROM_TOKENS_ONLY",
    "RADIUS_FROM_TOKENS_ONLY",
    "CONTRAST_AA_MINIMUM",
    "FOCUS_VISIBLE_REQUIRED",
    "NO_POSITIVE_TABINDEX",
    "TARGET_SIZE_MINIMUM",
    "INTERACTIVE_NAME_REQUIRED"
  ],
  "qualityChecks": [
    "Native dialogをshowModal()/close()でcontrolled stateへ同期",
    "Trigger relation、visible title、close control、focus lifecycleを検証",
    "Background inert、Escape、Tab loop、backdrop requestをinteraction test",
    "Light / Dark × Standard / Highと3 density、Desktop/Mobileを確認"
  ],
  "examples": [
    {
      "id": "quick-detail",
      "description": "一覧からIssue detailをmodal Drawerで確認する。",
      "code": "<Drawer\n  trigger={<Button variant=\"secondary\">詳細を表示</Button>}\n  title=\"MRD-142 の詳細\"\n  open={open}\n  onOpenChange={setOpen}\n  footer={<Button fullWidth>Issueを開く</Button>}\n>\n  <IssueSummary issue={issue} />\n</Drawer>"
    },
    {
      "id": "mobile-sidebar",
      "description": "同じSidebarをmobile modal containerへ配置する。",
      "code": "<Drawer trigger={<IconButton label=\"ナビゲーションを開く\" />} title=\"ナビゲーション\">\n  <Sidebar ariaLabel=\"Primary\">…</Sidebar>\n</Drawer>"
    }
  ],
  "runtime": {
    "compatibility": ">=0.1.0 <1.0.0",
    "rootElements": ["dialog"],
    "slots": ["trigger", "backdrop", "surface", "title", "close-control", "body", "footer"],
    "attributes": ["open", "aria-labelledby", "aria-haspopup", "aria-controls", "aria-expanded", "data-state", "data-side", "data-*"],
    "stateModel": ["native dialog open state", "data-state", "data-side"],
    "events": ["click", "cancel", "close", "keydown", "openchange"],
    "relations": ["trigger-dialog", "visible-title-name", "modal-inert-background", "contained-tab-sequence", "focus-return"],
    "provenance": ["component", "instance", "state", "contract-version", "runtime-version", "decision"]
  },
  "selectionRules": {
    "useWhen": ["現在の画面へ戻る前提の補助taskを画面端のmodal surfaceで完了する。"],
    "avoidWhen": ["短い判断、常設panel、長いworkflow、背景との並行操作が必要である。"],
    "alternatives": ["Dialog", "Sidebar", "layout panel", "dedicated page", "Popover"]
  },
  "negativeExamples": [
    { "pattern": "div role=dialogへaria-modal=trueだけを付け、背景を操作可能なままにする。", "reason": "aria-modalの宣言と実際のmodalityが一致せず、focusが背景へ逃げるため。", "ruleIds": ["FOCUS_VISIBLE_REQUIRED"] },
    { "pattern": "Native dialogのopen属性をReact renderだけで追加・削除する。", "reason": "close/cancel event、top layer、document blockingを壊すため。", "ruleIds": ["FOCUS_VISIBLE_REQUIRED"] },
    { "pattern": "Close Icon Buttonを省略し、backdrop tapまたはswipeだけに依存する。", "reason": "Keyboard、touch、支援技術で一貫したdismiss経路を失うため。", "ruleIds": ["INTERACTIVE_NAME_REQUIRED", "TARGET_SIZE_MINIMUM"] }
  ],
  "requiredScenarios": ["open", "closed", "default", "quick-detail", "long-content", "mobile-navigation", "narrow-viewport"],
  "implementationReadiness": {
    "status": "ready",
    "policyVersion": "0.1.0",
    "reviewedAt": "2026-07-22",
    "criteria": [
      { "id": "intent-boundary", "status": "passed", "evidence": ["intent", "selectionRules", "components/drawer.md#when-to-use"] },
      { "id": "public-api", "status": "passed", "evidence": ["props", "runtime.compatibility", "components/drawer.md#react-api-freeze"] },
      { "id": "runtime-semantics", "status": "passed", "evidence": ["runtime", "accessibility.aria", "keyboardInteractions"] },
      { "id": "accessibility", "status": "passed", "evidence": ["accessibility", "negativeExamples", "design/reviews/components.drawer.2026-07-22-components-drawer-02.review.json"] },
      { "id": "token-binding", "status": "passed", "evidence": ["tokenBindings", "tokenRefs", "index.html#drawerc"] },
      { "id": "responsive-behavior", "status": "passed", "evidence": ["responsiveBehavior", "components/drawer.md#responsive-behavior"] },
      { "id": "showcase-scenarios", "status": "passed", "evidence": ["requiredScenarios", "js/components-registry.js#drawer", "js/ui-builders.js"] },
      { "id": "validation-evidence", "status": "passed", "evidence": ["design/reviews/components.drawer.2026-07-22-components-drawer-02.review.json", "test/component-specs.test.js"] }
    ],
    "remainingToStable": ["React実装", "native dialog lifecycle integration tests", "visual regression baseline"]
  },
  "openQuestions": []
}
