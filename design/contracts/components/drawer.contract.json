      ]
    }
  ],
  "props": [
    {
      "name": "open",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Controlled open state。"
    },
    {
      "name": "onOpenChange",
      "type": "(open: boolean) => void",
      "required": false,
      "default": null,
      "description": "Open state変更を通知する。"
    }
  ],
