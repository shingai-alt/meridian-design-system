  "accessibility": {
    "requirements": [
      "表示専用rootを不要にtab順へ追加しない。",
      "状態は色だけで表さずtext、icon、shapeを併用する。"
    ],
    "aria": [
      "Native semanticsを優先し、ARIAは不足する関係と状態だけを補う。"
    ],
    "focus": [
      "Nested controlがある場合だけ、そのcontrolがfocusを受け取る。"
    ]
  },
  "keyboardInteractions": [],
  "usagePatterns": [
    {
      "id": "recommended-1",
      "title": "Primary context",
      "description": "初回利用・データ 0 件",
      "recommended": [
        "「何が無いのか」「作るとどうなるか」「最初の一歩」の 3 点を必ず含める。"
      ],
      "avoid": [
        "エラーによる非表示 → Error 表示で原因と回復手段を示す"
      ]
    },
    {
      "id": "recommended-2",
      "title": "Secondary context",
      "description": "検索結果 0 件(文言を変える)",
      "recommended": [
        "検索 0 件では「条件を変える・クリアする」導線を出す。"
      ],
      "avoid": [
        "エラーによる非表示 → Error 表示で原因と回復手段を示す"
      ]
    }
  ],
  "responsiveBehavior": {
    "desktop": {
      "summary": "DesktopでのEmpty State。",
      "rules": [
        "Gridまたはsectionのreading orderに沿って配置し、同種itemの寸法を揃える。",
        "面の入れ子を増やさない。"
      ],
      "avoid": [
        "Hoverだけで状態や操作を伝えない。"
      ]
    },
    "mobile": {
      "summary": "MobileでのEmpty State。",
      "rules": [
        "1列へreflowし、heading、content、actionの順序を保つ。",
        "Actionが複数ある場合は縦積みまたはmenuへ整理する。"
      ],
      "avoid": [
        "PC用とSP用に意味やAPIの異なるcomponentを複製しない。"
      ]
    },
    "touch": {
      "summary": "Touch入力でのEmpty State。",
      "rules": [
        "表示専用rootをtab順へ追加しない。",
        "内包する操作がある場合だけ、その操作targetを24px minimum、主要touch操作を原則44px以上にする。"
      ],
      "avoid": [
        "小さな隣接targetやgestureだけの操作を作らない。"
      ]
    }
  },
  "rules": [
    "NO_RAW_HEX_COLOR",
    "SPACING_FROM_TOKENS_ONLY",
    "RADIUS_FROM_TOKENS_ONLY",
    "CONTRAST_AA_MINIMUM",
    "STATE_NOT_COLOR_ONLY"
  ],
  "qualityChecks": [
    "When to use / not useの境界が明確",
    "PC / SP / touchで同じsemantic contractを維持",
    "公開tokenだけを参照",
    "Keyboardとaccessible nameを検証",
    "Light / Dark × Standard / Highと3 densityで確認"
  ],
  "examples": [
    {
      "id": "default",
      "description": "Empty Stateの標準例。",
      "code": "<EmptyState\n  icon={<FolderIcon />}\n  title=\"プロジェクトがありません\"\n  description=\"最初のプロジェクトを作成すると、ここにダッシュボードが表示されます。\"\n  action={<Button size=\"sm\">プロジェクトを作成</Button>}\n/>"
    }
  ],
  "openQuestions": [
    "React package実装時にDOM/ref/event APIと全visual slot bindingを確定し、coverage completeでstableへ移行する。"
  ]
}
