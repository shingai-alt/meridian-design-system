  "accessibility": {
    "requirements": [
      "表示専用rootを不要にtab順へ追加しない。",
      "状態は色だけで表さずtext、icon、shapeを併用する。"
    ],
    "aria": [
      "Native semanticsを優先し、ARIAは不足する関係と状態だけを補う。"
    ],
    "focus": [
      "Nested controlがある場合だけ、そのcontrolがfocusを受け取る。"
    ]
  },
  "keyboardInteractions": [],
  "usagePatterns": [
    {
      "id": "recommended-1",
      "title": "Primary context",
      "description": "chartにtitle、期間、legend、状態、menuを共通付与するとき。",
      "recommended": [
        "チャート色は chart-1〜6 トークンを順に使う。"
      ],
      "avoid": [
        "単一数値にはKPI Card、表形式比較にはTableを使う。"
      ]
    }
  ],
  "responsiveBehavior": {
    "desktop": {
      "summary": "DesktopでのAnalytics Chart Container。",
      "rules": [
        "Gridまたはsectionのreading orderに沿って配置し、同種itemの寸法を揃える。",
        "面の入れ子を増やさない。"
      ],
      "avoid": [
        "Hoverだけで状態や操作を伝えない。"
      ]
    },
    "mobile": {
      "summary": "MobileでのAnalytics Chart Container。",
      "rules": [
        "1列へreflowし、heading、content、actionの順序を保つ。",
        "Actionが複数ある場合は縦積みまたはmenuへ整理する。"
      ],
      "avoid": [
        "PC用とSP用に意味やAPIの異なるcomponentを複製しない。"
      ]
    },
    "touch": {
      "summary": "Touch入力でのAnalytics Chart Container。",
      "rules": [
        "表示専用rootをtab順へ追加しない。",
        "内包する操作がある場合だけ、その操作targetを24px minimum、主要touch操作を原則44px以上にする。"
      ],
      "avoid": [
        "小さな隣接targetやgestureだけの操作を作らない。"
      ]
    }
  },
  "rules": [
    "NO_RAW_HEX_COLOR",
    "SPACING_FROM_TOKENS_ONLY",
    "RADIUS_FROM_TOKENS_ONLY",
    "CONTRAST_AA_MINIMUM"
  ],
  "qualityChecks": [
    "When to use / not useの境界が明確",
    "PC / SP / touchで同じsemantic contractを維持",
    "公開tokenだけを参照",
    "Keyboardとaccessible nameを検証",
    "Light / Dark × Standard / Highと3 densityで確認"
  ],
  "examples": [
    {
      "id": "default",
      "description": "Analytics Chart Containerの標準例。",
      "code": "<ChartContainer title=\"API リクエスト数\" range={range} onRangeChange={setRange}>\n  <LineChart data={data} series={[\"production\", \"staging\"]} />\n</ChartContainer>"
    }
  ],
  "openQuestions": [
    "React package実装時にDOM/ref/event APIと全visual slot bindingを確定し、coverage completeでstableへ移行する。"
  ]
