  "selectionRules": {
    "useWhen": ["5件以上の恒常的なapp destinationを、複数groupまたはworkspace contextとともに提示する。"],
    "avoidWhen": ["少数のpeer view、page内目次、temporary action list、またはmobile overlayそのものを表す。"],
    "alternatives": ["Tabs", "Top Bar", "Table of Contents", "Menu", "Drawer"]
  },
  "negativeExamples": [
