    "mobile": { "summary": "同じSidebar DOMをDrawer内へ配置する。", "rules": ["Drawer triggerはaria-controlsとaria-expandedを所有", "Open/close、Escape、focus returnはDrawer/App Shell責務", "Navigation後のcloseもparentが決定"], "avoid": ["Sidebar rootへdialog semanticsを付ける", "Viewportでdestinationを削除"] },
    "touch": { "summary": "Child controlのtarget sizeとvisible labelを維持する。", "rules": ["最低24px target", "Primary navigationは44px推奨", "Hover非依存"], "avoid": ["Swipeだけで開閉", "Tooltipだけでdestination labelを提供"] }
  },
  "rules": ["INTERACTIVE_NAME_REQUIRED", "FOCUS_VISIBLE_REQUIRED", "TARGET_SIZE_MINIMUM", "NO_POSITIVE_TABINDEX", "NO_RAW_HEX_COLOR", "SPACING_FROM_TOKENS_ONLY"],
  "qualityChecks": ["Rootが名前付きnavである。", "Groupがul/li hierarchyを持つ。", "menu/menuitem/roving tabindexを使わない。", "Current pageが1件だけ。", "Narrow containerでもdocument横overflowを起こさない。", "Drawer placementの責務がparentへ分離されている。"],
  "examples": [
