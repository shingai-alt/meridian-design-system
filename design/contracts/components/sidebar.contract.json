  "accessibility": {
    "requirements": ["Rootはaccessible nameを持つnav。", "Destination groupはul/li hierarchyを持つ。", "Current pageはSidebar全体で1件だけaria-current=pageを持つ。", "Icon-onlyへ自動collapseせず可視labelを維持する。"],
