  "id": "sidebar",
  "name": "Sidebar",
  "status": "draft",
  "category": "navigation",
  "description": "恒常的なapp destinationをgroup化して提示する、名前付きnavigation landmark。",
  "source": { "humanDoc": "components/sidebar.md", "registry": "js/components-registry.js#sidebar" },
  "intent": {
    "whenToUse": ["5件以上の恒常的destinationを持つapp。", "Workspace switcher、group、footer actionをprimary navigationと同じ領域で構成する。"],
    "whenNotToUse": ["3〜4件のpeer viewはTabsまたはTop Barを使う。", "Page内section navigationはTable of Contentsを使う。", "Mobile overlay containerはDrawerを使う。", "Commandや一時actionはMenuを使う。"],
    "principles": [1, 2, 3, 5, 6]
  },
  "anatomy": [
    { "part": "root", "required": true, "description": "Accessible nameを持つnative nav landmark。" },
    { "part": "header", "required": false, "description": "Workspace switcherなどnavigation contextを示す領域。" },
    { "part": "group", "required": true, "description": "Optional labelとulを持つdestination group。" },
    { "part": "navigation-item", "required": true, "description": "li内へ置くNavigation Item。Current pageは全Sidebarで1件。" },
    { "part": "footer", "required": false, "description": "User menuやsettingsなど恒常的な補助control領域。" }
  ],
  "variants": {
    "default": {
      "intent": "App ShellまたはDrawer内で同じnavigation DOMを提示する唯一のvariant。",
      "tokenRefs": { "background": "--sidebar-bg", "border": "--border", "width": "--sidebar-w" },
      "states": {}
    }
  },
  "sizes": {},
  "states": [
