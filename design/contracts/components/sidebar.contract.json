    { "pattern": "Sidebar自身がmobile overlay、focus trap、開閉triggerを所有する。", "reason": "Navigationの意味とDrawer/App Shellのplacement責務が混ざるため。", "ruleIds": ["FOCUS_VISIBLE_REQUIRED"] }
