    { "id": "responsive-placement", "title": "Responsive placement", "description": "同じSidebarをApp ShellまたはDrawerへ配置する。", "recommended": ["Visibilityとoverlay behaviorをparentへ委譲", "同じariaLabelとlist DOMを維持"], "avoid": ["Mobile専用Sidebar API", "Sidebar自身のfocus trap"] }
