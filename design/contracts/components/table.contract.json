    "whenToUse": [
      "属性を比較しながら走査する一覧"
    ],
    "whenNotToUse": [
      "カード的な閲覧が主 → Card grid",
      "編集・仮想スクロールが必要 → Data Grid"
    ],
    "principles": [
      1,
      2,
      3,
      5,
      6
    ]
  },
