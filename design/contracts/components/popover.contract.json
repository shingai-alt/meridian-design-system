  "intent": {
    "whenToUse": [
      "フィルタ・簡易フォーム・補足 UI"
    ],
    "whenNotToUse": [
      "テキストのみの補足 → Tooltip",
      "重要な確認 → Dialog"
    ],
    "principles": [
      1,
      2,
      3,
      5,
      6
    ]
  },
  "anatomy": [
