    "registry": "js/components-registry.js#checkbox"
  },
  "intent": {
    "whenToUse": [
      "複数選択リスト",
      "利用規約への同意"
    ],
    "whenNotToUse": [
      "即時に反映されるトグル → Switch",
      "排他選択 → Radio"
    ],
    "principles": [
      1,
      2,
      3,
      5,
      6
