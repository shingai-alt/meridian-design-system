  "accessibility": {
    "requirements": [
      "label propから空でないaccessible nameと同文のTooltipを生成する。",
      "iconとspinnerはaria-hiddenにし、glyph名をaccessible nameへ重複させない。",
      "Tooltipはhoverとfocusで表示し、Escapeで閉じ、root focusを奪わない。",
      "Keyboardとpointerで同じactionを実行する。",
      "Targetは24px minimumを満たし、touch中心ではxlの44pxを優先する。",
      "Focus indicatorを視認でき、sticky layerで完全に隠さない。"
    ],
    "aria": [
      "Native buttonを使い、labelをaria-labelへ写像する。",
      "Tooltipをaria-describedbyで関連付ける。",
      "loading中はaria-busy=trueとaria-disabled=trueを設定する。"
    ],
    "focus": [
      "focus-visibleで--focus-ringを使う。",
      "Positive tabindexを使わずDOMとvisualの順序を一致させる。",
      "Tooltip表示・非表示でfocusを移動しない。"
    ]
  },
  "keyboardInteractions": [
    { "key": "Enter", "action": "Actionを実行する。" },
    { "key": "Space", "action": "Actionを実行する。" },
    { "key": "Tab", "action": "通常のdocument順序でrootへ出入りする。" },
    { "key": "Escape", "action": "表示中のTooltipを閉じ、root focusを維持する。" }
  ],
  "usagePatterns": [
    {
      "id": "toolbar-action",
      "title": "Toolbar action",
      "description": "認識可能な編集・表示補助操作を密度の高いtoolbarへ置く。",
      "recommended": ["labelを動詞から始め、Tooltipとaria-labelへ同じ文字列を使う。", "複数Icon Buttonを並べる場合はToolbarのroving tabindex contractを親で管理する。"],
      "avoid": ["初見で判別できない独自glyphを説明なしで使う。", "Icon Button自体にaria-pressedを追加してselection control化する。"]
    },
    {
      "id": "destructive-row-action",
      "title": "Destructive row action",
      "description": "行単位の削除など破壊的な補助操作。",
      "recommended": ["danger variantと対象を含むlabelを使う。", "確認DialogまたはUndoを用意する。"],
      "avoid": ["主要な削除確認をIcon Buttonだけで完結させる。"]
    }
  ],
  "responsiveBehavior": {
    "desktop": {
      "summary": "同一APIの正方形controlをtask densityで選ぶ。",
      "rules": ["mdを標準、table rowではxs/sm、主要toolbarではmd/lgを使う。", "hoverとfocusのTooltipを別々に確認する。"],
      "avoid": ["hoverだけに操作名を閉じ込めない。"]
    },
    "mobile": {
      "summary": "意味とAPIを変えず、spacingとsizeで誤操作を防ぐ。",
      "rules": ["touch中心の主要操作はxlを優先する。", "狭い画面でも隣接targetとの間隔を保つ。"],
      "avoid": ["PC用とSP用に異なるlabelやactionを持つIcon Buttonを複製しない。"]
    },
    "touch": {
      "summary": "24px minimum、主要touch操作44px推奨を満たす。",
      "rules": ["xsでも24px未満にしない。", "繰り返し使う主要操作はxlまたは十分なspacingを使う。"],
      "avoid": ["24px円が隣接targetと重なる配置を作らない。"]
    }
  },
  "rules": ["NO_RAW_HEX_COLOR", "SPACING_FROM_TOKENS_ONLY", "RADIUS_FROM_TOKENS_ONLY", "CONTRAST_AA_MINIMUM", "FOCUS_VISIBLE_REQUIRED", "NO_POSITIVE_TABINDEX", "TARGET_SIZE_MINIMUM", "INTERACTIVE_NAME_REQUIRED"],
  "qualityChecks": [
    "label、Tooltip、aria-labelが同じ操作名である。",
    "native button属性、type=button、ref、handler guardが確定している。",
    "全variant/state/sizeのvisual slotがtokenへ結線されている。",
    "Light/Dark × Standard/High、3 density、mobileでShowcaseを確認する。"
  ],
  "examples": [
    { "id": "default", "description": "標準の補助操作。", "code": "<IconButton label=\"フィルターを開く\" icon={<FilterIcon />} />" },
    { "id": "danger", "description": "対象を明示した破壊的補助操作。", "code": "<IconButton label=\"プロジェクトを削除\" icon={<TrashIcon />} variant=\"danger\" />" },
    { "id": "loading", "description": "nameとfocusを保持する非同期操作。", "code": "<IconButton label=\"再読み込み\" icon={<RefreshIcon />} loading />" }
  ],
  "runtime": {
    "compatibility": ">=0.1.0 <1.0.0",
    "rootElements": ["button"],
    "slots": ["icon", "tooltip", "spinner"],
