  "selectionRules": {
    "useWhen": ["単一の補助actionを認識可能なglyphで表せる。", "可視ラベルを置くと周辺contentの走査を妨げる。"],
    "avoidWhen": ["主要actionまたは説明が必要ならButtonを使う。", "navigationならLinkを使う。", "selection stateなら専用selection controlを使う。"],
    "alternatives": ["button", "link", "switch", "checkbox", "segmented-control"]
  },
  "negativeExamples": [
    { "pattern": "labelなし、またはtitle属性だけでIcon Buttonを命名する。", "reason": "titleは一貫したaccessible nameやkeyboard利用可能な説明を保証しないため。", "ruleIds": ["INTERACTIVE_NAME_REQUIRED"] },
    { "pattern": "primary variantで主要CTAをiconだけにする。", "reason": "可視ラベルとaction hierarchyを失うため。", "ruleIds": ["INTERACTIVE_NAME_REQUIRED"] },
    { "pattern": "aria-pressedを追加してtoggleとして使う。", "reason": "commandとselectionの状態モデルが混在するため。", "ruleIds": ["INTERACTIVE_NAME_REQUIRED"] }
  ],
  "requiredScenarios": ["default", "hover", "active", "focus", "disabled", "loading", "ghost", "secondary", "danger", "xs", "sm", "md", "lg", "xl", "tooltip-hover", "tooltip-focus", "form-submit"],
  "openQuestions": []
