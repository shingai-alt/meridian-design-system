      "status": "draft",
      "contractVersion": "0.2.0",
      "source": "design/contracts/components/button.contract.json",
      "sourceDigest": "sha256-790c2b53ffe56f5606bd68ca34278539dfb79ef5d8eae98afb62c1a13c162a48",
      "pilotScope": [
        "team-invitation"
      ],
      "variants": [
        "primary",
        "secondary",
        "tertiary",
        "ghost",
        "danger"
      ],
      "states": [
